{
  "version": 6,
  "configurePresets": [
    {
      "name": "arm64",
      "displayName": "macOS arm64, Apple clang, ccache",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_APPLE_SILICON_PROCESSOR": "arm64",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "arm64-release",
      "inherits": "arm64",
      "displayName": "macOS arm64 release for the app bundle (tools/build.sh release, tools/bundle.sh)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PORTABLEKIT_RELEASE": "ON",
        "PORTABLEKIT_FFMPEG": "bundled"
      }
    }
  ],
  "buildPresets": [
    { "name": "arm64", "configurePreset": "arm64" },
    { "name": "arm64-release", "configurePreset": "arm64-release" }
  ]
}

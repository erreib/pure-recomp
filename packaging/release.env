# The macOS release of pure-recomp, for the framework's packer (task 029):
#   tools/bundle.sh   (runs vendor/portablekit/scripts/release_macos.sh --game . --no-dmg build/release)
# See vendor/portablekit/docs/RELEASING.md and docs/release.md.
RELEASE_NAME="Wipeout Pure"
RELEASE_SLUG=pure-recomp
RELEASE_TARGET=PureNative
RELEASE_APP_ID=com.erikreiblein.pure-recomp
RELEASE_SUMMARY="Wipeout Pure (PSP, 2005) recompiled to run natively on Apple Silicon Macs, from your own disc image"
RELEASE_MACOS_CATEGORY=public.app-category.racing-games
RELEASE_OVERLAYS=0
# The profile is the repository itself (PROFILE_DIR in CMakeLists.txt); a developer build falls back to its game/.
RELEASE_PROFILE_DIR=.
# One program: no RELEASE_EXTRA_EXECUTABLES, no RELEASE_RESOURCES.
# Lower-case globs of the game's own file names, which must never be in an artifact, on top of the packer's own
# (eboot*, *.iso, *.prx, *.bin, param.sfo, ms0, savedata, ...): the disc id and the save folders named after it, the
# DLC save folder, the disc's archives and its other files, and the dump's usual name ("Wipeout Pure (USA) ...").
# A bare *wipeout*pure* would match the app's own name (Wipeout Pure.app, its executable and icon).
RELEASE_GAME_NAMES="ucus98612* ppcd00001* *.wad *.at3 *.pmf icon0.png pic1.png devmenu.cfg *wipeout*pure*usa*"

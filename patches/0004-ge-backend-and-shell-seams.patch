@@ -0,0 +1,135 @@
+// The Vulkan shell: the VulkanRenderer behind host::Shell (shell.hpp). The
+// renderer is the window shell and the Vulkan GE backend's draw path at once
+// and is not split; this adapter owns it and forwards each shell call to the
+// renderer method the HLE and the interface called before the seam existed,
+// with the same arguments, so nothing it shows changes.
+//
+// present(): the Vulkan backend's image is the renderer's own target, which
+// VulkanRenderer::present shows for the display address as it always has, so
+// the image is not looked at. Another backend's Cpu image is uploaded into the
+// display address's target first (VulkanRenderer::upload_frame), then shown by
+// the same present: how a non-Vulkan backend's picture reaches the window, at
+// the cost of a copy a frame.
+//
+// initialize_ui(): ImGui's SDL3 platform backend for the renderer's window
+// (ImGui_ImplSDL3_InitForVulkan, which the interface layer called itself before
+// each shell chose its own), then the renderer's ImGui Vulkan backend.
+#include "shell/vulkan_shell.hpp"
+
+#include "gpu/vulkan_renderer.hpp"
+
+#include "backends/imgui_impl_sdl3.h"
+
+#include <memory>
+#include <utility>
+
+namespace portablekit::host {
+namespace {
+
+class VulkanShell final : public Shell {
+public:
+    VulkanShell() : renderer_(std::make_unique<gpu::VulkanRenderer>()) {}
+
+    [[nodiscard]] gpu::VulkanRenderer &renderer() noexcept { return *renderer_; }
+
+    const char *name() const noexcept override { return "vulkan"; }
+    bool initialize(const ShellConfig &config, std::string &error) override {
+        gpu::RendererConfig renderer_config;
+        if (!config.title.empty()) renderer_config.title = config.title;
+        return renderer_->initialize(renderer_config, error);
+    }
+    void shutdown() override { renderer_->shutdown(); }
+    bool available() const noexcept override { return renderer_->available(); }
+    bool has_window() const noexcept override { return renderer_->window() != nullptr; }
+
+    bool pump_events() override { return renderer_->pump_events(); }
+    void sample_pad() override { renderer_->sample_pad(); }
+    PadState pad() const noexcept override { return renderer_->pad(); }
+    MouseMotion take_mouse_motion() noexcept override { return renderer_->take_mouse_motion(); }
+    MouseMotion take_touch_motion() noexcept override { return renderer_->take_touch_motion(); }
+    bool take_touch_menu() noexcept override { return renderer_->take_touch_menu(); }
+    bool touch_controls_visible() const noexcept override { return renderer_->touch_controls_visible(); }
+    const input::touch::Controls &touch_controls() const override { return renderer_->touch_controls(); }
+    bool mouse_captured() const noexcept override { return renderer_->mouse_captured(); }
+    bool quit_requested() const noexcept override { return renderer_->quit_requested(); }
+    void request_quit() noexcept override { renderer_->request_quit(); }
+    void set_game_input(bool enabled) override { renderer_->set_game_input(enabled); }
+    void set_pointer_free(bool free) override { renderer_->set_pointer_free(free); }
+    void set_scripted_key(int position, bool down) override { renderer_->set_scripted_key(position, down); }
+    void set_scripted_input(bool scripted) override { renderer_->set_scripted_input(scripted); }
+    void set_event_hook(std::function<bool(const SDL_Event &)> hook) override {
+        renderer_->set_event_hook(std::move(hook));
+    }
+    SDL_Gamepad *gamepad() const noexcept override { return renderer_->gamepad(); }
+    SDL_Window *window() const noexcept override { return renderer_->window(); }
+
+    bool present(const gpu::PresentedImage &image, std::uint32_t display_address,
+                 std::optional<std::chrono::steady_clock::time_point> moment) override {
+        if (image.api == gpu::ImageApi::Cpu && image.pixels != nullptr)
+            renderer_->upload_frame(display_address, image.pixels, image.width, image.height, image.width);
+        return renderer_->present(display_address, moment);
+    }
+    void present_due() override { renderer_->present_due(); }
+    void present_until(std::chrono::steady_clock::time_point wake) override { renderer_->present_until(wake); }
+    void pause_interpolation() override { renderer_->pause_interpolation(); }
+    void set_fast_forward(bool on) override { renderer_->set_fast_forward(on); }
+    void hold_frame(bool hold) override { renderer_->hold_frame(hold); }
+    void capture_window(const std::string &path) override { renderer_->capture_window(path); }
+    float game_aspect() const noexcept override { return renderer_->game_aspect(); }
+    float display_refresh() const noexcept override { return renderer_->display_refresh(); }
+    double frame_rate_now() const noexcept override { return renderer_->frame_rate_now(); }
+    void set_frame_rate(settings::FrameRate rate) override { renderer_->set_frame_rate(rate); }
+    void set_frame_rate_auto(bool automatic) override { renderer_->set_frame_rate_auto(automatic); }
+    void set_window_scale(std::uint32_t scale) override { renderer_->set_window_scale(scale); }
+    void set_fullscreen(bool fullscreen) override { renderer_->set_fullscreen(fullscreen); }
+    void set_present_mode(settings::PresentMode mode) override { renderer_->set_present_mode(mode); }
+    bool supports_present_mode(settings::PresentMode mode) const override {
+        return renderer_->supports_present_mode(mode);
+    }
+    void set_aspect(settings::Aspect aspect) override { renderer_->set_aspect(aspect); }
+    void set_sharp_screen(bool sharp) override { renderer_->set_sharp_screen(sharp); }
+    void set_perf_overlay(bool visible) override { renderer_->set_perf_overlay(visible); }
+    std::string device_name() const override { return renderer_->device_name(); }
+
+    bool initialize_ui(std::string &error) override {
+        if (!ui_platform_) {
+            if (!ImGui_ImplSDL3_InitForVulkan(renderer_->window())) {
+                error = "ImGui_ImplSDL3_InitForVulkan failed";
+                return false;
+            }
+            ui_platform_ = true;
+        }
+        if (renderer_->initialize_ui(error)) return true;
+        ImGui_ImplSDL3_Shutdown();
+        ui_platform_ = false;
+        return false;
+    }
+    void shutdown_ui() override {
+        renderer_->shutdown_ui();
+        if (!ui_platform_) return;
+        ImGui_ImplSDL3_Shutdown();
+        ui_platform_ = false;
+    }
+    void begin_ui_frame() override { renderer_->begin_ui_frame(); }
+    void set_ui_draw_data(ImDrawData *draw_data) override { renderer_->set_ui_draw_data(draw_data); }
+    void present_ui(bool show_game) override { renderer_->present_ui(show_game); }
+
+private:
+    // Destroyed with the shell; ~VulkanRenderer shuts it down, as it did when
+    // the HLE owned it.
+    std::unique_ptr<gpu::VulkanRenderer> renderer_;
+    // ImGui's SDL3 platform backend runs for this shell's window.
+    bool ui_platform_{};
+};
+
+const ShellRegistration registration("vulkan", "an SDL window drawn with Vulkan (the VulkanRenderer)",
+                                     [] { return std::unique_ptr<Shell>(new VulkanShell()); });
+
+} // namespace
+
+gpu::VulkanRenderer *vulkan_renderer(Shell *shell) noexcept {
+    auto *vulkan = dynamic_cast<VulkanShell *>(shell);
+    return vulkan != nullptr ? &vulkan->renderer() : nullptr;
+}
+
+} // namespace portablekit::host

diff --git a/host/gpu/ge_backend.cpp b/host/gpu/ge_backend.cpp
new file mode 100644
index 0000000..f336930
--- /dev/null
+++ b/host/gpu/ge_backend.cpp
@@ -0,0 +1,110 @@
+#include "ge_backend.hpp"
+
+#include "../profile.hpp"
+
+#include <algorithm>
+#include <fstream>
+#include <utility>
+
+namespace portablekit::gpu {
+namespace {
+
+struct Entry {
+    std::string name;
+    std::string description;
+    BackendFactory factory;
+};
+
+// Made on first use, so it is there for registrations that run before main().
+std::vector<Entry> &registry() {
+    static std::vector<Entry> entries;
+    return entries;
+}
+
+const Entry *find(std::string_view name) {
+    for (const Entry &entry : registry())
+        if (entry.name == name) return &entry;
+    return nullptr;
+}
+
+} // namespace
+
+void register_backend(std::string name, BackendFactory factory, std::string description) {
+    for (Entry &entry : registry()) {
+        if (entry.name == name) {
+            entry.factory = std::move(factory);
+            entry.description = std::move(description);
+            return;
+        }
+    }
+    registry().push_back({std::move(name), std::move(description), std::move(factory)});
+}
+
+std::unique_ptr<GeBackend> make_backend(std::string_view name) {
+    const Entry *entry = find(name);
+    if (entry == nullptr || !entry->factory) return nullptr;
+    return entry->factory();
+}
+
+std::vector<std::string> backend_names() {
+    std::vector<std::string> names;
+    names.reserve(registry().size());
+    for (const Entry &entry : registry()) names.push_back(entry.name);
+    return names;
+}
+
+std::string backend_description(std::string_view name) {
+    const Entry *entry = find(name);
+    return entry != nullptr ? entry->description : std::string{};
+}
+
+std::string selected_backend() {
+    const char *name = portablekit::env("GE_BACKEND");
+    return name != nullptr && *name != '\0' ? std::string(name) : std::string("vulkan");
+}
+
+BackendRegistration::BackendRegistration(const char *name, const char *description, BackendFactory factory) {
+    register_backend(name, std::move(factory), description != nullptr ? description : "");
+}
+
+std::vector<std::uint8_t> encode_bmp(const std::uint8_t *pixels, std::uint32_t width, std::uint32_t height) {
+    const std::uint32_t row_bytes = (width * 3u + 3u) & ~3u;
+    const std::uint32_t image_bytes = row_bytes * height;
+    std::vector<std::uint8_t> file(54u + image_bytes, 0u);
+    const auto put32 = [&](std::size_t at, std::uint32_t value) {
+        file[at] = static_cast<std::uint8_t>(value);
+        file[at + 1u] = static_cast<std::uint8_t>(value >> 8u);
+        file[at + 2u] = static_cast<std::uint8_t>(value >> 16u);
+        file[at + 3u] = static_cast<std::uint8_t>(value >> 24u);
+    };
+    file[0] = 'B';
+    file[1] = 'M';
+    put32(2u, 54u + image_bytes);
+    put32(10u, 54u);
+    put32(14u, 40u);
+    put32(18u, width);
+    put32(22u, height);
+    file[26] = 1u;
+    file[28] = 24u;
+    put32(34u, image_bytes);
+    for (std::uint32_t y = 0; y < height; ++y) {
+        const std::uint8_t *source = pixels + static_cast<std::size_t>(y) * width * 4u;
+        std::uint8_t *destination = file.data() + 54u + static_cast<std::size_t>(height - 1u - y) * row_bytes;
+        for (std::uint32_t x = 0; x < width; ++x) {
+            destination[x * 3u + 0u] = source[x * 4u + 2u];
+            destination[x * 3u + 1u] = source[x * 4u + 1u];
+            destination[x * 3u + 2u] = source[x * 4u + 0u];
+        }
+    }
+    return file;
+}
+
+bool write_bmp_file(const std::string &path, const std::uint8_t *pixels, std::uint32_t width, std::uint32_t height) {
+    const std::vector<std::uint8_t> file = encode_bmp(pixels, width, height);
+    std::ofstream out(path, std::ios::binary);
+    if (!out) return false;
+    out.write(reinterpret_cast<const char *>(file.data()), static_cast<std::streamsize>(file.size()));
+    return static_cast<bool>(out);
+}
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/ge_backend.hpp b/host/gpu/ge_backend.hpp
new file mode 100644
index 0000000..98cd6f9
--- /dev/null
+++ b/host/gpu/ge_backend.hpp
@@ -0,0 +1,173 @@
+#pragma once
+
+// The GE backend seam: what the PSP's graphics engine did (render targets in
+// VRAM, textures, blending, the stencil kept as alpha, read-backs into guest
+// memory), apart from the shell around it (window, swapchain, pad, scripted
+// input, interface, frame pacing and interpolation). The HLE hands every draw,
+// block transfer, read-back, write-back and CPU-drawn picture to a GeBackend,
+// and asks it for the image to show at each flip.
+//
+// The backends:
+//   vulkan  the VulkanRenderer's own draw path (vulkan_ge_backend.cpp). The
+//           renderer is also the window shell and is not split: this backend
+//           draws with the shell's device into the targets the shell shows,
+//           so it needs the window (needs_window()).
+//   null    draws nothing, shows a black image and counts draws
+//           (null_backend.cpp). Needs no window and no GPU.
+// <prefix>_GE_BACKEND names the one to use (vulkan when unset). A backend in
+// the game's own sources adds itself with a BackendRegistration; the file has
+// to be linked into the program directly, not through a static library, or
+// the linker drops it with its registration.
+//
+// A frame, as the shell drives it:
+//   begin_frame()                      once before the first frame and once after each flip
+//   begin_display_list(), submit()...  while display lists run
+//   block_transfer(), write_back_depth(), read_back_framebuffer(), upload_frame()
+//                                      as the GE and the CPU need them
+//   write_back_frame()                 at the flip, before the image is asked for
+//   present_image(display_address)     at the flip: the image of that display target
+//   (the shell shows it, captures it with capture_frame() when asked, then
+//    calls begin_frame() for the next frame)
+#include "ge_state.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace portablekit::gpu {
+
+class VulkanRenderer;
+
+// What a backend is made with.
+struct BackendConfig {
+    // The window shell's renderer when there is a window, null without one.
+    // The Vulkan backend draws with its device and into its targets.
+    VulkanRenderer *vulkan_shell{};
+    // Multiples of 480x272 to draw at; 0 leaves it to the backend (the Vulkan
+    // one follows the shell's Video settings, 2x by default).
+    std::uint32_t internal_scale{};
+    // Nearest-neighbour texture sampling instead of bilinear.
+    bool sharp_textures{};
+};
+
+// The API a presented image belongs to, which tells the shell how to show it.
+enum class ImageApi : std::uint8_t {
+    None,    // nothing to show
+    Cpu,     // `pixels` in host memory
+    Vulkan,  // `image` is a VkImage, `view` its VkImageView
+    Metal,   // `image` is an id<MTLTexture>
+};
+
+// The display target at a display address, as an image the shell composites
+// with its interface and presents. The backend never touches the swapchain.
+// Handles are owned by the backend and stay valid until the next call into it.
+struct PresentedImage {
+    ImageApi api{ImageApi::None};
+    std::uint32_t address{};  // the display address the image shows
+    std::uint32_t width{};    // in pixels (a multiple of 480x272 at the internal scale)
+    std::uint32_t height{};
+    // Cpu: rows of width RGBA pixels, red in the low byte.
+    const std::uint8_t *pixels{};
+    // Vulkan and Metal: the API's handles as integers.
+    std::uint64_t image{};
+    std::uint64_t view{};
+
+    [[nodiscard]] bool valid() const noexcept { return api != ImageApi::None; }
+};
+
+class GeBackend {
+public:
+    GeBackend() = default;
+    GeBackend(const GeBackend &) = delete;
+    GeBackend &operator=(const GeBackend &) = delete;
+    virtual ~GeBackend() = default;
+
+    // The name it is registered under.
+    [[nodiscard]] virtual const char *name() const noexcept = 0;
+    // True when it cannot be made without the window shell (BackendConfig::
+    // vulkan_shell). Asked before initialize(), so the HLE knows whether a run
+    // without a window (<prefix>_NO_RENDER) can have it.
+    [[nodiscard]] virtual bool needs_window() const noexcept { return false; }
+
+    // Returns false and fills `error` when the backend cannot run.
+    virtual bool initialize(const BackendConfig &config, std::string &error) = 0;
+    // Frees everything it made, every per-target resource before the pools
+    // they came from. Called once; the destructor calls it if nobody did.
+    virtual void shutdown() = 0;
+
+    // Per-frame bookkeeping, before the frame's first call (see the top of
+    // this file). A backend that begins its frames lazily, at the first draw,
+    // as the Vulkan one does, may do nothing here.
+    virtual void begin_frame() = 0;
+    // Before walking each display list, and after a block transfer: guest
+    // memory may have changed since textures were last looked up.
+    virtual void begin_display_list() = 0;
+    // GPU vertex decode (GeState::set_raw_vertices): whether the lists about
+    // to run should hand transformed triangle draws over undecoded, and also
+    // decode them for checking. Off unless the backend can draw raw vertices.
+    [[nodiscard]] virtual bool gpu_decode() const { return false; }
+    [[nodiscard]] virtual bool check_gpu_decode() const { return false; }
+    // One draw with the whole GE state it is drawn with. Guest memory is read
+    // for textures and palettes (and raw vertices); a texture that lies in a
+    // render target samples that target, the one starting at its address first.
+    virtual void submit(const DrawCall &call, const GuestMemory &memory) = 0;
+    // Before the HLE copies a block transfer's rows in guest memory: when the
+    // source lies in a target the backend drew, its pixels are written to
+    // guest memory first, so the copy gets the picture.
+    virtual void block_transfer(const BlockTransfer &transfer, GuestMemory &memory) = 0;
+    // The displayed target's pixels into guest VRAM, in the guest's format,
+    // for game code that reads the frame with the CPU. Once per flip.
+    virtual void write_back_frame(GuestMemory &memory) = 0;
+    // One target into guest VRAM, when `address` lies in one the backend drew.
+    virtual void read_back_framebuffer(std::uint32_t address, GuestMemory &memory) = 0;
+    // The depth of the target at `color_address` as the GE keeps it (16 bits,
+    // z 0-65535) in rows of `depth_stride` pixels from `depth_address`, for
+    // game code that reads depth at a GE SIGNAL. Returns whether it wrote.
+    virtual bool write_back_depth(std::uint32_t color_address, std::uint32_t depth_address,
+                                  std::uint32_t depth_stride, GuestMemory &memory, const char *why) = 0;
+    // A picture the CPU drew (a movie frame): `width` x `height` RGBA pixels in
+    // rows of `stride`, shown by the next present of `display_address`.
+    virtual void upload_frame(std::uint32_t display_address, const std::uint8_t *pixels, std::uint32_t width,
+                              std::uint32_t height, std::uint32_t stride) = 0;
+    // The display target at `display_address` (or, if nothing was drawn there,
+    // the one drawn last), once per flip.
+    [[nodiscard]] virtual PresentedImage present_image(std::uint32_t display_address) = 0;
+    // The last presented image as a BMP; false when there is none.
+    virtual bool capture_frame(const std::string &path) = 0;
+
+    [[nodiscard]] virtual std::uint64_t draws_submitted() const noexcept = 0;
+    [[nodiscard]] virtual std::uint64_t frames_presented() const noexcept = 0;
+};
+
+using BackendFactory = std::function<std::unique_ptr<GeBackend>()>;
+
+// Adds a backend under `name`; a later registration of the same name replaces it.
+void register_backend(std::string name, BackendFactory factory, std::string description = {});
+// A new, uninitialised backend, or null when no backend has that name.
+[[nodiscard]] std::unique_ptr<GeBackend> make_backend(std::string_view name);
+// The registered names, in the order they were registered.
+[[nodiscard]] std::vector<std::string> backend_names();
+[[nodiscard]] std::string backend_description(std::string_view name);
+// The backend <prefix>_GE_BACKEND names; "vulkan" when it is unset or empty.
+[[nodiscard]] std::string selected_backend();
+
+// One line in a backend's source file registers it before main():
+//   const BackendRegistration registration("null", "draws nothing", [] { return std::make_unique<NullBackend>(); });
+struct BackendRegistration {
+    BackendRegistration(const char *name, const char *description, BackendFactory factory);
+};
+
+// The PSP's screen.
+inline constexpr std::uint32_t kScreenWidth = 480u;
+inline constexpr std::uint32_t kScreenHeight = 272u;
+
+// `width` x `height` RGBA pixels (red in the low byte), top row first, as a
+// 24-bit bottom-up BMP, the format the Vulkan renderer's captures have.
+[[nodiscard]] std::vector<std::uint8_t> encode_bmp(const std::uint8_t *pixels, std::uint32_t width,
+                                                   std::uint32_t height);
+bool write_bmp_file(const std::string &path, const std::uint8_t *pixels, std::uint32_t width, std::uint32_t height);
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/null_backend.cpp b/host/gpu/null_backend.cpp
new file mode 100644
index 0000000..9d75e35
--- /dev/null
+++ b/host/gpu/null_backend.cpp
@@ -0,0 +1,110 @@
+// A GE backend that draws nothing: it accepts every call, shows a black
+// image and counts the draws. The smallest thing that satisfies the seam
+// (ge_backend.hpp), and the file to copy when starting a new backend.
+//
+// <prefix>_GE_BACKEND=null runs the game through the seam with no GPU work:
+// without a window (<prefix>_NO_RENDER set, even to nothing) it needs no GPU at
+// all, and the frame rate is the one the game would have with a renderer that
+// costs nothing. Every 600 frames, and at the end, it prints the frames and the
+// draws it was handed.
+#include "ge_backend.hpp"
+
+#include <chrono>
+#include <iostream>
+#include <vector>
+
+namespace portablekit::gpu {
+namespace {
+
+constexpr std::uint64_t kReportEvery = 600u;
+
+class NullBackend final : public GeBackend {
+public:
+    ~NullBackend() override { shutdown(); }
+
+    const char *name() const noexcept override { return "null"; }
+
+    bool initialize(const BackendConfig &, std::string &) override {
+        // Opaque black, as a cleared target shows.
+        black_.assign(static_cast<std::size_t>(kScreenWidth) * kScreenHeight * 4u, 0u);
+        for (std::size_t i = 3u; i < black_.size(); i += 4u) black_[i] = 0xFFu;
+        started_ = std::chrono::steady_clock::now();
+        report_start_ = started_;
+        initialized_ = true;
+        std::cout << "[render] GE backend null: draws nothing, presents black\n";
+        return true;
+    }
+
+    void shutdown() override {
+        if (!initialized_) return;
+        initialized_ = false;
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started_).count();
+        std::cout << "[render] null backend: " << frames_ << " frames, " << draws_ << " draws submitted, "
+                  << transfers_ << " block transfers, " << uploads_ << " uploads in " << seconds << " s\n"
+                  << std::flush;
+    }
+
+    // Draws are counted, nothing else: there is no frame to begin.
+    void begin_frame() override {}
+    void begin_display_list() override {}
+    void submit(const DrawCall &, const GuestMemory &) override { ++draws_; }
+    // Nothing was drawn, so guest memory already holds what there is to copy.
+    void block_transfer(const BlockTransfer &, GuestMemory &) override { ++transfers_; }
+    void write_back_frame(GuestMemory &) override {}
+    void read_back_framebuffer(std::uint32_t, GuestMemory &) override {}
+    bool write_back_depth(std::uint32_t, std::uint32_t, std::uint32_t, GuestMemory &, const char *) override {
+        return false;
+    }
+    void upload_frame(std::uint32_t, const std::uint8_t *, std::uint32_t, std::uint32_t, std::uint32_t) override {
+        ++uploads_;
+    }
+
+    PresentedImage present_image(std::uint32_t display_address) override {
+        ++frames_;
+        if (frames_ % kReportEvery == 0u) report();
+        PresentedImage image;
+        image.api = ImageApi::Cpu;
+        image.address = display_address;
+        image.width = kScreenWidth;
+        image.height = kScreenHeight;
+        image.pixels = black_.data();
+        return image;
+    }
+
+    bool capture_frame(const std::string &path) override {
+        return frames_ != 0u && write_bmp_file(path, black_.data(), kScreenWidth, kScreenHeight);
+    }
+
+    std::uint64_t draws_submitted() const noexcept override { return draws_; }
+    std::uint64_t frames_presented() const noexcept override { return frames_; }
+
+private:
+    void report() {
+        const auto now = std::chrono::steady_clock::now();
+        const double seconds = std::chrono::duration<double>(now - report_start_).count();
+        const std::uint64_t frames = frames_ - report_frames_;
+        std::cout << "[render] null backend: frame " << frames_ << ", " << draws_ << " draws submitted ("
+                  << (draws_ - report_draws_) << " in the last " << frames << " frames, "
+                  << (seconds > 0.0 ? static_cast<double>(frames) / seconds : 0.0) << " fps)\n";
+        report_start_ = now;
+        report_frames_ = frames_;
+        report_draws_ = draws_;
+    }
+
+    std::vector<std::uint8_t> black_;
+    bool initialized_{};
+    std::uint64_t draws_{};
+    std::uint64_t frames_{};
+    std::uint64_t transfers_{};
+    std::uint64_t uploads_{};
+    std::chrono::steady_clock::time_point started_{};
+    std::chrono::steady_clock::time_point report_start_{};
+    std::uint64_t report_frames_{};
+    std::uint64_t report_draws_{};
+};
+
+const BackendRegistration registration("null", "draws nothing, presents black, counts draws",
+                                       [] { return std::unique_ptr<GeBackend>(new NullBackend()); });
+
+} // namespace
+} // namespace portablekit::gpu
diff --git a/host/gpu/vulkan_ge_backend.cpp b/host/gpu/vulkan_ge_backend.cpp
new file mode 100644
index 0000000..5f52f4f
--- /dev/null
+++ b/host/gpu/vulkan_ge_backend.cpp
@@ -0,0 +1,73 @@
+// The Vulkan GE backend: the VulkanRenderer's own draw path behind the seam
+// (ge_backend.hpp). The renderer is the window shell as well and is not split;
+// this adapter forwards each backend call to the renderer method that did the
+// same work before the seam existed, so what it draws is unchanged.
+//
+// What stays fused: the renderer begins its frame lazily, at the first draw,
+// upload or present after the last flip, and ends it in VulkanRenderer::present,
+// the shell's present, which shows the target present_image() names. So
+// begin_frame() does nothing here, and present_image() only names the image.
+#include "ge_backend.hpp"
+#include "vulkan_renderer.hpp"
+
+namespace portablekit::gpu {
+namespace {
+
+class VulkanGeBackend final : public GeBackend {
+public:
+    ~VulkanGeBackend() override { shutdown(); }
+
+    const char *name() const noexcept override { return "vulkan"; }
+    bool needs_window() const noexcept override { return true; }
+
+    bool initialize(const BackendConfig &config, std::string &error) override {
+        if (config.vulkan_shell == nullptr || !config.vulkan_shell->available()) {
+            error = "the Vulkan backend draws with the window's renderer, and there is none";
+            return false;
+        }
+        renderer_ = config.vulkan_shell;
+        return true;
+    }
+
+    // The targets, textures and pools belong to the renderer, which frees them
+    // in VulkanRenderer::shutdown() (targets before the descriptor pool).
+    void shutdown() override { renderer_ = nullptr; }
+
+    void begin_frame() override {}
+    void begin_display_list() override { renderer_->begin_display_list(); }
+    bool gpu_decode() const override { return renderer_->gpu_decode(); }
+    bool check_gpu_decode() const override { return renderer_->check_gpu_decode(); }
+    void submit(const DrawCall &call, const GuestMemory &memory) override { renderer_->submit(call, memory); }
+    void block_transfer(const BlockTransfer &transfer, GuestMemory &memory) override {
+        renderer_->read_back_framebuffer(transfer.source, memory);
+    }
+    void write_back_frame(GuestMemory &memory) override { renderer_->write_back_frame(memory); }
+    void read_back_framebuffer(std::uint32_t address, GuestMemory &memory) override {
+        renderer_->read_back_framebuffer(address, memory);
+    }
+    bool write_back_depth(std::uint32_t color_address, std::uint32_t depth_address, std::uint32_t depth_stride,
+                          GuestMemory &memory, const char *why) override {
+        return renderer_->write_back_depth(color_address, depth_address, depth_stride, memory, why);
+    }
+    void upload_frame(std::uint32_t display_address, const std::uint8_t *pixels, std::uint32_t width,
+                      std::uint32_t height, std::uint32_t stride) override {
+        renderer_->upload_frame(display_address, pixels, width, height, stride);
+    }
+    PresentedImage present_image(std::uint32_t display_address) override {
+        return renderer_->display_image(display_address);
+    }
+    bool capture_frame(const std::string &path) override { return renderer_->capture_frame(path); }
+    std::uint64_t draws_submitted() const noexcept override { return renderer_ ? renderer_->draws_submitted() : 0u; }
+    std::uint64_t frames_presented() const noexcept override {
+        return renderer_ ? renderer_->frames_presented() : 0u;
+    }
+
+private:
+    VulkanRenderer *renderer_{};
+};
+
+const BackendRegistration registration("vulkan", "the Vulkan renderer's draw path (needs the window)",
+                                       [] { return std::unique_ptr<GeBackend>(new VulkanGeBackend()); });
+
+} // namespace
+} // namespace portablekit::gpu

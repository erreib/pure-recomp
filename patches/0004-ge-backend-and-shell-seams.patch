+#include "shell/gamepad.hpp"
+
+#include "../profile.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cmath>
+#include <span>
+
+namespace portablekit::host {
+namespace {
+
+// SDL3's names, in its order (SDL_GetGamepadStringForButton, ...ForAxis).
+constexpr std::array<std::string_view, kGamepadButtons> kButtonNames = {
+    "a",      "b",          "x",        "y",       "back",    "guide",   "start",
+    "leftstick", "rightstick", "leftshoulder", "rightshoulder", "dpup", "dpdown", "dpleft",
+    "dpright", "misc1",     "paddle1",  "paddle2", "paddle3", "paddle4", "touchpad",
+    "misc2",  "misc3",      "misc4",    "misc5",   "misc6"};
+constexpr std::array<std::string_view, kGamepadAxes> kAxisNames = {"leftx", "lefty", "rightx", "righty",
+                                                                   "lefttrigger", "righttrigger"};
+
+bool same_name(std::string_view a, std::string_view b) {
+    return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+               return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y));
+           });
+}
+
+} // namespace
+
+std::optional<GamepadButton> gamepad_button_from_name(std::string_view name) {
+    for (int i = 0; i < kGamepadButtons; ++i)
+        if (same_name(name, kButtonNames[static_cast<std::size_t>(i)])) return static_cast<GamepadButton>(i);
+    return std::nullopt;
+}
+
+std::optional<GamepadAxis> gamepad_axis_from_name(std::string_view name) {
+    if (!name.empty() && (name.front() == '+' || name.front() == '-')) name.remove_prefix(1);
+    for (int i = 0; i < kGamepadAxes; ++i)
+        if (same_name(name, kAxisNames[static_cast<std::size_t>(i)])) return static_cast<GamepadAxis>(i);
+    return std::nullopt;
+}
+
+PadTuning pad_tuning() {
+    static const bool trace = portablekit::env("TRACE_PAD") != nullptr;
+    const settings::Settings &player = settings::current();
+    PadTuning value{};
+    value.dead_zone = player.dead_zone;
+    value.trigger = player.trigger;
+    value.triggers = player.trigger_profile;
+    value.right_stick = player.right_stick_zone;
+    // The right stick is a real nub on this release, so driving the D-pad
+    // from it as well would turn the camera twice.
+    value.right_stick_mode = player.right_stick;
+    value.invert_x = player.invert_camera_x;
+    value.invert_y = player.invert_camera_y;
+    // A PlayStation pad already carries the PSP's own face buttons, so the
+    // positional mapping puts confirm on circle where the prompts want it.
+    value.confirm_south = player.confirm_south;
+    value.trace = trace;
+    return value;
+}
+
+void read_gamepad(const std::function<bool(GamepadButton)> &is_held, const std::function<float(GamepadAxis)> &axis,
+                  PadState &pad, int &analog_x, int &analog_y) {
+    const PadTuning tuning = pad_tuning();
+    std::uint32_t &buttons = pad.buttons;
+    const auto held = [&](GamepadButton button, std::uint32_t bit) {
+        if (is_held(button)) buttons |= bit;
+    };
+    held(GamepadButton::DpadUp, 0x0010u);
+    held(GamepadButton::DpadRight, 0x0020u);
+    held(GamepadButton::DpadDown, 0x0040u);
+    held(GamepadButton::DpadLeft, 0x0080u);
+    held(GamepadButton::LeftShoulder, 0x0100u);
+    held(GamepadButton::RightShoulder, 0x0200u);
+    held(GamepadButton::Start, 0x0008u);
+    held(GamepadButton::Back, 0x0001u);
+    held(GamepadButton::North, 0x1000u);
+    held(GamepadButton::West, 0x8000u);
+    // The game prompts "circle Enter / cross Back", and on a PlayStation pad
+    // those are the same two buttons in the same two places.
+    held(GamepadButton::South, tuning.confirm_south ? 0x2000u : 0x4000u);
+    held(GamepadButton::East, tuning.confirm_south ? 0x4000u : 0x2000u);
+
+    // The PSP triggers are digital, and games hold L or R for long stretches,
+    // so the analog triggers press the same bits as the shoulders.
+    // A game's trigger profiles put other buttons on them, such as a weapon's
+    // attack for shooting. The buttons copied keep working.
+    std::uint32_t left_trigger = 0x0100u;   // L
+    std::uint32_t right_trigger = 0x0200u;  // R
+    const std::span<const TriggerProfile> profiles = portablekit::game().trigger_profiles;
+    if (tuning.triggers != 0u && tuning.triggers <= profiles.size()) {
+        left_trigger = profiles[tuning.triggers - 1u].left;
+        right_trigger = profiles[tuning.triggers - 1u].right;
+    }
+    if (axis(GamepadAxis::LeftTrigger) > tuning.trigger) buttons |= left_trigger;
+    if (axis(GamepadAxis::RightTrigger) > tuning.trigger) buttons |= right_trigger;
+
+    const float right_x = axis(GamepadAxis::RightX);
+    const float right_y = axis(GamepadAxis::RightY);
+    // The HD release has its own right-stick camera, so the stick normally goes
+    // there. Pressing the D-pad bits as well would turn the camera twice, hence
+    // the either/or: the claw emulation is only for builds where that path is
+    // not wanted.
+    if (tuning.right_stick_mode == settings::RightStick::DPad) {
+        if (right_x < -tuning.right_stick) buttons |= 0x0080u;
+        if (right_x > tuning.right_stick) buttons |= 0x0020u;
+        if (right_y < -tuning.right_stick) buttons |= 0x0010u;
+        if (right_y > tuning.right_stick) buttons |= 0x0040u;
+    }
+
+    // Rescale the live range, otherwise leaving the dead zone snaps the stick
+    // straight to a sixth of its travel.
+    const auto deflect = [&](float x, float y, std::uint8_t &out_x, std::uint8_t &out_y) {
+        const float length = std::sqrt(x * x + y * y);
+        if (length <= tuning.dead_zone) return;
+        const float scale = std::min((length - tuning.dead_zone) / (1.0f - tuning.dead_zone), 1.0f) / length;
+        out_x = static_cast<std::uint8_t>(std::clamp(0x80 + static_cast<int>(x * scale * 127.0f), 0, 255));
+        out_y = static_cast<std::uint8_t>(std::clamp(0x80 + static_cast<int>(y * scale * 127.0f), 0, 255));
+    };
+    if (tuning.right_stick_mode == settings::RightStick::Camera)
+        deflect(tuning.invert_x ? -right_x : right_x, tuning.invert_y ? -right_y : right_y, pad.right_x, pad.right_y);
+
+    const float left_x = axis(GamepadAxis::LeftX);
+    const float left_y = axis(GamepadAxis::LeftY);
+    std::uint8_t nub_x = 0x80u;
+    std::uint8_t nub_y = 0x80u;
+    deflect(left_x, left_y, nub_x, nub_y);
+    analog_x += static_cast<int>(nub_x) - 0x80;
+    analog_y += static_cast<int>(nub_y) - 0x80;
+}
+
+} // namespace portablekit::host
diff --git a/host/shell/gamepad.hpp b/host/shell/gamepad.hpp
new file mode 100644
index 0000000..f9ceb35
--- /dev/null
+++ b/host/shell/gamepad.hpp
@@ -0,0 +1,57 @@
+#pragma once
+
+// How a gamepad becomes the PSP pad, for every shell: the SDL shells read a
+// real or the input script's virtual gamepad (sdl_pad.cpp), the headless
+// shell the input script's steps (headless_shell.cpp). No SDL here, so the
+// buttons and axes are numbered and named as SDL3 numbers and names them
+// (SDL_GamepadButton, SDL_GamepadAxis, SDL_GetGamepadStringForButton);
+// sdl_pad.cpp checks the numbers against SDL's.
+#include "shell/shell.hpp"
+
+#include "settings/settings.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string_view>
+
+namespace portablekit::host {
+
+enum class GamepadButton : int {
+    South, East, West, North, Back, Guide, Start, LeftStick, RightStick, LeftShoulder, RightShoulder,
+    DpadUp, DpadDown, DpadLeft, DpadRight, Misc1, RightPaddle1, LeftPaddle1, RightPaddle2, LeftPaddle2,
+    Touchpad, Misc2, Misc3, Misc4, Misc5, Misc6, Count
+};
+enum class GamepadAxis : int { LeftX, LeftY, RightX, RightY, LeftTrigger, RightTrigger, Count };
+inline constexpr int kGamepadButtons = static_cast<int>(GamepadButton::Count);
+inline constexpr int kGamepadAxes = static_cast<int>(GamepadAxis::Count);
+
+// SDL_GetGamepadButtonFromString and SDL_GetGamepadAxisFromString: SDL's
+// names ("a", "start", "dpdown", "leftx", "righttrigger"), in any case; an
+// axis may carry a leading + or -.
+[[nodiscard]] std::optional<GamepadButton> gamepad_button_from_name(std::string_view name);
+[[nodiscard]] std::optional<GamepadAxis> gamepad_axis_from_name(std::string_view name);
+
+struct PadTuning {
+    float dead_zone{0.15f};
+    float trigger{0.25f};
+    std::uint32_t triggers{};
+    float right_stick{0.5f};
+    settings::RightStick right_stick_mode{settings::RightStick::Camera};
+    bool invert_x{};
+    bool invert_y{};
+    bool confirm_south{};
+    bool trace{false};
+};
+
+// Read on every poll, so the in-game menu's changes apply at once.
+[[nodiscard]] PadTuning pad_tuning();
+
+// Adds one gamepad's state to the pad bits and to the analog offsets the
+// keyboard path also writes, so the two sources simply OR together. `held`
+// tells whether a button is down, `axis` an axis's position, -1 to 1 (0 to 1
+// for the triggers), each read once per button or axis the mapping uses.
+void read_gamepad(const std::function<bool(GamepadButton)> &held, const std::function<float(GamepadAxis)> &axis,
+                  PadState &pad, int &analog_x, int &analog_y);
+
+} // namespace portablekit::host
diff --git a/host/shell/headless_shell.cpp b/host/shell/headless_shell.cpp
new file mode 100644
index 0000000..8869597
--- /dev/null
+++ b/host/shell/headless_shell.cpp
@@ -0,0 +1,255 @@
+// The headless shell: no window, no GPU, no SDL. The pad the game reads comes
+// from the input script (<prefix>_INPUT_SCRIPT, and the live file
+// <prefix>_INPUT_LIVE) read at pad level: the same file format and step names
+// as ui/input_script.cpp (shell/script_steps.hpp), run frame by frame as the
+// flips are presented, and mapped to the PSP pad as the SDL shells map their
+// gamepad (shell/gamepad.hpp), so one script drives the game the same way in
+// a window and without one.
+//
+//   pad NAME[+NAME...] [N]  hold gamepad buttons (SDL's names) for N frames, 4 by default
+//   axis NAME VALUE         hold an axis at VALUE, -1 to 1, as the virtual gamepad does
+//   shot NAME               the GE backend's picture (capture_frame) as <prefix>_SCREENSHOT_DIR/NAME.bmp
+//   quit                    pump_events() returns false: the run ends
+// key, mouse, click, text and drop need a window; each is reported once and
+// ignored.
+#include "shell/gamepad.hpp"
+#include "shell/script_steps.hpp"
+#include "shell/shell.hpp"
+
+#include "../profile.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <optional>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace portablekit::host {
+namespace {
+
+class HeadlessShell final : public Shell {
+public:
+    const char *name() const noexcept override { return "headless"; }
+    bool initialize(const ShellConfig &config, std::string &) override {
+        capture_frame_ = config.capture_frame;
+        // Mouse steps are reported when they come up (run()).
+        bool uses_pad = false;
+        bool uses_mouse = false;
+        script::load(script_, uses_pad, uses_mouse);
+        ready_ = true;
+        return true;
+    }
+    void shutdown() override { ready_ = false; }
+    bool available() const noexcept override { return ready_; }
+    bool has_window() const noexcept override { return false; }
+
+    // The script's steps run at present(); nothing else happens between flips.
+    bool pump_events() override { return !quit_; }
+    void sample_pad() override {}
+    PadState pad() const noexcept override { return game_input_ ? pad_ : PadState{}; }
+    MouseMotion take_mouse_motion() noexcept override { return {}; }
+    MouseMotion take_touch_motion() noexcept override { return {}; }
+    bool take_touch_menu() noexcept override { return false; }
+    bool touch_controls_visible() const noexcept override { return false; }
+    const input::touch::Controls &touch_controls() const override { return touch_; }
+    bool mouse_captured() const noexcept override { return false; }
+    bool quit_requested() const noexcept override { return quit_; }
+    void request_quit() noexcept override { quit_ = true; }
+    void set_game_input(bool enabled) override { game_input_ = enabled; }
+    void set_pointer_free(bool) override {}
+    void set_scripted_key(int, bool) override {}
+    void set_scripted_input(bool) override {}
+    void set_event_hook(std::function<bool(const SDL_Event &)>) override {}
+    SDL_Gamepad *gamepad() const noexcept override { return nullptr; }
+    SDL_Window *window() const noexcept override { return nullptr; }
+
+    // A flip: the script's steps due run, then the captures they asked for
+    // are taken, of the image this flip presents.
+    bool present(const gpu::PresentedImage &image, std::uint32_t,
+                 std::optional<std::chrono::steady_clock::time_point>) override {
+        tick();
+        for (const std::string &path : captures_) {
+            if (!capture_frame_ || !capture_frame_(path))
+                std::cout << "[script] cannot capture the frame to " << path << std::endl;
+        }
+        captures_.clear();
+        return image.valid();
+    }
+    void present_due() override {}
+    void present_until(std::chrono::steady_clock::time_point) override {}
+    void pause_interpolation() override {}
+    void set_fast_forward(bool) override {}
+    void hold_frame(bool) override {}
+    // No window: the next presented picture is the GE backend's.
+    void capture_window(const std::string &path) override { captures_.push_back(path); }
+    float game_aspect() const noexcept override {
+        return static_cast<float>(gpu::kScreenWidth) / static_cast<float>(gpu::kScreenHeight);
+    }
+    float display_refresh() const noexcept override { return 0.0f; }
+    double frame_rate_now() const noexcept override { return 0.0; }
+    void set_frame_rate(settings::FrameRate) override {}
+    void set_frame_rate_auto(bool) override {}
+    void set_window_scale(std::uint32_t) override {}
+    void set_fullscreen(bool) override {}
+    void set_present_mode(settings::PresentMode) override {}
+    bool supports_present_mode(settings::PresentMode) const override { return false; }
+    void set_aspect(settings::Aspect) override {}
+    void set_sharp_screen(bool) override {}
+    void set_perf_overlay(bool) override {}
+    std::string device_name() const override { return {}; }
+
+    bool initialize_ui(std::string &error) override {
+        error = "the headless shell has no window to draw the interface in";
+        return false;
+    }
+    void shutdown_ui() override {}
+    void begin_ui_frame() override {}
+    void set_ui_draw_data(ImDrawData *) override {}
+    void present_ui(bool) override {}
+
+private:
+    // Releases due later: the buttons a `pad` step pressed.
+    struct Release {
+        std::uint64_t frame{};
+        std::vector<GamepadButton> buttons;
+    };
+
+    // ui::script::tick() at pad level: one script frame per flip.
+    void tick() {
+        if (script_.steps.empty() && releases_.empty() && script_.live_path.empty()) return;
+        ++frame_;
+        if (!script_.live_path.empty() && frame_ % 10u == 0u) script::read_live(script_, frame_);
+        bool changed = false;
+        for (auto it = releases_.begin(); it != releases_.end();) {
+            if (it->frame > frame_) {
+                ++it;
+                continue;
+            }
+            for (GamepadButton button : it->buttons) held_[static_cast<std::size_t>(button)] = false;
+            changed = true;
+            it = releases_.erase(it);
+        }
+        while (!script_.steps.empty() && script_.steps.front().frame <= frame_) {
+            changed = run(script_.steps.front()) || changed;
+            script_.steps.pop_front();
+        }
+        if (changed) update_pad();
+    }
+
+    // Returns whether the pad changed.
+    bool run(const script::Step &step) {
+        std::cout << "[script] frame " << frame_ << ": " << step.action << " " << step.argument << std::endl;
+        if (step.action == "pad") {
+            const auto [names, frames] = script::name_and_frames(step.argument, script::kHoldFrames);
+            std::vector<GamepadButton> buttons;
+            std::stringstream list(names);
+            std::string name;
+            while (std::getline(list, name, '+')) {
+                const std::optional<GamepadButton> button = gamepad_button_from_name(name);
+                if (!button) {
+                    std::cout << "[script] unknown button " << name << std::endl;
+                    continue;
+                }
+                held_[static_cast<std::size_t>(*button)] = true;
+                buttons.push_back(*button);
+            }
+            releases_.push_back({frame_ + frames, buttons});
+            return true;
+        }
+        if (step.action == "axis") {
+            const auto space = step.argument.find(' ');
+            const std::optional<GamepadAxis> axis = gamepad_axis_from_name(step.argument.substr(0, space));
+            const float value =
+                space == std::string::npos ? 0.0f : std::strtof(step.argument.c_str() + space + 1u, nullptr);
+            if (!axis) {
+                std::cout << "[script] unknown axis " << step.argument << std::endl;
+                return false;
+            }
+            // What SDL_SetJoystickVirtualAxis is given in a window.
+            const auto index = static_cast<std::size_t>(*axis);
+            axes_[index] = static_cast<std::int16_t>(std::clamp(value, -1.0f, 1.0f) * 32767.0f);
+            axis_set_[index] = true;
+            return true;
+        }
+        if (step.action == "shot") {
+            const char *dir = portablekit::env("SCREENSHOT_DIR");
+            const std::string name = step.argument.empty() ? "frame_" + std::to_string(frame_) : step.argument;
+            capture_window((dir != nullptr ? std::string(dir) : std::string(".")) + "/" + name + ".bmp");
+            return false;
+        }
+        if (step.action == "quit") {
+            quit_ = true;
+            return false;
+        }
+        if (step.action == "key" || step.action == "mouse" || step.action == "click" || step.action == "text" ||
+            step.action == "drop") {
+            if (ignored_.insert(step.action).second)
+                std::cout << "[script] " << step.action
+                          << " steps need a window; the headless shell ignores them" << std::endl;
+            return false;
+        }
+        std::cout << "[script] unknown action " << step.action << std::endl;
+        return false;
+    }
+
+    // An axis as SDL reads the input script's virtual gamepad back: a stick
+    // as it was set; a trigger 0 until a step sets it, then its -1 to 1 spread
+    // over 0 to 1 (SDL maps a virtual joystick's full axis range onto the
+    // trigger's).
+    float axis_value(GamepadAxis axis) const {
+        const auto index = static_cast<std::size_t>(axis);
+        const int raw = axes_[index];
+        if (axis == GamepadAxis::LeftTrigger || axis == GamepadAxis::RightTrigger) {
+            if (!axis_set_[index]) return 0.0f;
+            return static_cast<float>((raw + 32768) * 32767 / 65535) / 32767.0f;
+        }
+        return std::clamp(static_cast<float>(raw) / 32767.0f, -1.0f, 1.0f);
+    }
+
+    // The PSP pad from the held buttons and axes, as SdlPad::sample makes it
+    // from a gamepad with no key, mouse button or touch held.
+    void update_pad() {
+        PadState next{};
+        int analog_x = 0;
+        int analog_y = 0;
+        read_gamepad([this](GamepadButton button) { return held_[static_cast<std::size_t>(button)]; },
+                     [this](GamepadAxis axis) { return axis_value(axis); }, next, analog_x, analog_y);
+        next.analog_x = static_cast<std::uint8_t>(std::clamp(0x80 + analog_x, 0, 255));
+        next.analog_y = static_cast<std::uint8_t>(std::clamp(0x80 + analog_y, 0, 255));
+        if (pad_tuning().trace && (next.buttons != pad_.buttons || next.analog_x != pad_.analog_x ||
+                                   next.analog_y != pad_.analog_y || next.right_x != pad_.right_x ||
+                                   next.right_y != pad_.right_y)) {
+            std::cout << "[pad] buttons 0x" << std::hex << next.buttons << std::dec << " analog "
+                      << static_cast<int>(next.analog_x) << "," << static_cast<int>(next.analog_y) << " right "
+                      << static_cast<int>(next.right_x) << "," << static_cast<int>(next.right_y) << std::endl;
+        }
+        pad_ = next;
+    }
+
+    bool ready_{};
+    bool quit_{};
+    bool game_input_{true};
+    PadState pad_{};
+    input::touch::Controls touch_;
+    std::function<bool(const std::string &)> capture_frame_;
+    std::vector<std::string> captures_;
+
+    script::Steps script_;
+    std::uint64_t frame_{};
+    std::vector<Release> releases_;
+    std::array<bool, kGamepadButtons> held_{};
+    std::array<std::int16_t, kGamepadAxes> axes_{};
+    std::array<bool, kGamepadAxes> axis_set_{};
+    std::set<std::string> ignored_;
+};
+
+const ShellRegistration registration("headless", "no window and no GPU; the pad from the input script",
+                                     [] { return std::unique_ptr<Shell>(new HeadlessShell()); });
+
+} // namespace
+} // namespace portablekit::host
diff --git a/host/shell/script_steps.cpp b/host/shell/script_steps.cpp
new file mode 100644
index 0000000..d9057de
--- /dev/null
+++ b/host/shell/script_steps.cpp
@@ -0,0 +1,95 @@
+#include "shell/script_steps.hpp"
+
+#include "../profile.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+
+namespace portablekit::host::script {
+
+std::string trim(const std::string &text) {
+    const auto first = text.find_first_not_of(" \t");
+    if (first == std::string::npos) return {};
+    return text.substr(first, text.find_last_not_of(" \t") - first + 1u);
+}
+
+std::pair<std::string, std::uint64_t> name_and_frames(const std::string &argument, std::uint64_t fallback) {
+    const auto space = argument.find_last_of(' ');
+    if (space == std::string::npos) return {argument, fallback};
+    const std::string last = argument.substr(space + 1u);
+    if (last.empty() || last.find_first_not_of("0123456789") != std::string::npos) return {argument, fallback};
+    return {argument.substr(0, space), std::max<std::uint64_t>(1u, std::strtoull(last.c_str(), nullptr, 10))};
+}
+
+bool mouse_step(const std::string &action) { return action == "mouse" || action == "click"; }
+
+bool parse_step(std::string item, std::uint64_t base, Step &step) {
+    item = trim(item);
+    const auto colon = item.find(':');
+    if (item.empty() || colon == std::string::npos) return false;
+    step.frame = base + std::strtoull(item.substr(0, colon).c_str(), nullptr, 10);
+    const std::string rest = trim(item.substr(colon + 1u));
+    const auto space = rest.find(' ');
+    step.action = rest.substr(0, space);
+    step.argument = space == std::string::npos ? std::string{} : trim(rest.substr(space + 1u));
+    return true;
+}
+
+void sort_steps(Steps &s) {
+    std::stable_sort(s.steps.begin(), s.steps.end(),
+                     [](const Step &a, const Step &b) { return a.frame < b.frame; });
+}
+
+void read_live(Steps &s, std::uint64_t frame) {
+    std::ifstream file(s.live_path, std::ios::binary);
+    if (!file) return;
+    file.seekg(0, std::ios::end);
+    const std::streamoff size = file.tellg();
+    if (size < s.live_offset) s.live_offset = 0;  // the file was replaced
+    if (size == s.live_offset) return;
+    file.seekg(s.live_offset);
+    std::string line;
+    bool added = false;
+    while (std::getline(file, line)) {
+        if (file.eof()) break;  // an incomplete last line: read it next time
+        s.live_offset = file.tellg();
+        Step step;
+        if (parse_step(line, frame, step)) {
+            s.steps.push_back(step);
+            added = true;
+        }
+    }
+    if (added) sort_steps(s);
+}
+
+void load(Steps &s, bool &uses_pad, bool &uses_mouse) {
+    uses_pad = false;
+    uses_mouse = false;
+    if (const char *live = portablekit::env("INPUT_LIVE"); live != nullptr && *live != '\0') {
+        s.live_path = live;
+        // Only what is appended after start-up counts.
+        std::ifstream file(s.live_path, std::ios::binary | std::ios::ate);
+        if (file) s.live_offset = file.tellg();
+        uses_pad = true;
+        uses_mouse = true;
+        std::cout << "[script] reading live input from " << s.live_path << std::endl;
+    }
+    if (const char *text = portablekit::env("INPUT_SCRIPT"); text != nullptr) {
+        std::stringstream list(text);
+        std::string item;
+        while (std::getline(list, item, ';')) {
+            Step step;
+            if (!parse_step(item, 0u, step)) continue;
+            uses_pad = uses_pad || step.action == "pad" || step.action == "axis";
+            uses_mouse = uses_mouse || mouse_step(step.action);
+            s.steps.push_back(step);
+        }
+        sort_steps(s);
+        std::cout << "[script] " << s.steps.size() << " steps" << std::endl;
+    }
+}
+
+} // namespace portablekit::host::script
diff --git a/host/shell/script_steps.hpp b/host/shell/script_steps.hpp
new file mode 100644
index 0000000..6e72dc0
--- /dev/null
+++ b/host/shell/script_steps.hpp
@@ -0,0 +1,50 @@
+#pragma once
+
+// The input script's grammar (<prefix>_INPUT_SCRIPT and the live file
+// <prefix>_INPUT_LIVE; the actions are documented in ui/input_script.hpp),
+// shared by the shells that read it: ui/input_script.cpp turns the steps into
+// SDL events at a shell's window, the headless shell (headless_shell.cpp)
+// into its pad. No SDL here.
+#include <cstdint>
+#include <deque>
+#include <ios>
+#include <string>
+#include <utility>
+
+namespace portablekit::host::script {
+
+// Frames a scripted button stays down: ImGui samples the pad once per frame.
+inline constexpr std::uint64_t kHoldFrames = 4u;
+
+struct Step {
+    std::uint64_t frame{};
+    std::string action;
+    std::string argument;
+};
+
+// The steps not run yet, by frame, and the live file being followed.
+struct Steps {
+    std::deque<Step> steps;
+    // <prefix>_INPUT_LIVE: a file whose appended lines are read as they come.
+    std::string live_path;
+    std::streamoff live_offset{};
+};
+
+[[nodiscard]] std::string trim(const std::string &text);
+// "NAME N": the name, and N frames if the last word is a number.
+[[nodiscard]] std::pair<std::string, std::uint64_t> name_and_frames(const std::string &argument,
+                                                                  std::uint64_t fallback);
+[[nodiscard]] bool mouse_step(const std::string &action);
+// Parses `frame:action argument`; `base` is added to the frame.
+bool parse_step(std::string item, std::uint64_t base, Step &step);
+void sort_steps(Steps &s);
+// Reads the lines appended to the live file since the last call. Their frames
+// count from `frame`, so a line `30:pad a` presses it half a second after it
+// is read.
+void read_live(Steps &s, std::uint64_t frame);
+// Reads <prefix>_INPUT_LIVE and <prefix>_INPUT_SCRIPT into `s` and says what
+// it found ("[script] N steps"). `uses_pad` and `uses_mouse`: whether a step
+// presses the gamepad or moves the mouse; the live file counts as both.
+void load(Steps &s, bool &uses_pad, bool &uses_mouse);
+
+} // namespace portablekit::host::script
diff --git a/host/shell/sdl_pad.cpp b/host/shell/sdl_pad.cpp

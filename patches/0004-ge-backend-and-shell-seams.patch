@@ -0,0 +1,56 @@
+#pragma once
+
+// The PSP pad of a shell with an SDL window: the keyboard and the mouse's
+// buttons through the player's bindings, the first gamepad (or the input
+// script's virtual one, which takes over), the on-screen touch controls and
+// the input script's keys. Taken out of VulkanRenderer so the SDL shells share
+// it; the renderer's Impl derives from it, so its members keep their names.
+#include "shell/gamepad.hpp"
+#include "shell/shell.hpp"
+
+#include "input/bindings.hpp"
+#include "input/touch_controls.hpp"
+
+#include <SDL3/SDL.h>
+
+#include <array>
+#include <cstdint>
+
+namespace portablekit::host {
+
+struct SdlPad {
+    PadState pad{};
+    SDL_Gamepad *gamepad{};
+    SDL_JoystickID gamepad_id{};
+    // While off, the game reads a neutral pad (an interface screen is up).
+    bool game_input{true};
+    // Buttons held when the game got its input back stay hidden from it until
+    // they are released.
+    bool suppress_held{};
+    std::uint32_t suppressed_buttons{};
+    // Keys the input script holds (set_scripted_key): a pushed SDL event does
+    // not change SDL's keyboard snapshot, which the bindings read.
+    std::array<bool, input::kKeyPositions> scripted_keys{};
+
+    // Only the first pad is used; a second one arriving is ignored rather than
+    // stealing the stick from whoever is already playing.
+    void open_gamepad(SDL_JoystickID id);
+    // Picks up a pad that was already plugged in before the window existed, and
+    // falls back to a still-connected second pad when the first one is unplugged.
+    void scan_gamepads();
+    void close_gamepad(SDL_JoystickID id);
+
+    // The PSP pad from the keyboard, the mouse's buttons and the gamepad as
+    // they are now, into `pad`. `focused`: the window has input focus (the
+    // keyboard counts only then); `mouse_captured` and `mouse_buttons` (bit n:
+    // SDL mouse button n held): the pointer the game has; `touch`: the
+    // on-screen controls while shown, else null; `frames`: frames presented
+    // (<prefix>_AUTO_CONFIRM).
+    void sample(bool focused, bool mouse_captured, std::uint32_t mouse_buttons, const input::touch::Controls *touch,
+                std::uint64_t frames);
+};
+
+// read_gamepad (gamepad.hpp) over an SDL gamepad.
+void read_gamepad(SDL_Gamepad *device, PadState &pad, int &analog_x, int &analog_y);
+
+} // namespace portablekit::host
diff --git a/host/shell/shell.cpp b/host/shell/shell.cpp
new file mode 100644
index 0000000..18ed47a
--- /dev/null
+++ b/host/shell/shell.cpp
@@ -0,0 +1,68 @@
+#include "shell/shell.hpp"
+
+#include "../profile.hpp"
+
+#include <utility>
+
+namespace portablekit::host {
+namespace {
+
+struct Entry {
+    std::string name;
+    std::string description;
+    ShellFactory factory;
+};
+
+// Made on first use, so it is there for registrations that run before main().
+std::vector<Entry> &registry() {
+    static std::vector<Entry> entries;
+    return entries;
+}
+
+const Entry *find(std::string_view name) {
+    for (const Entry &entry : registry())
+        if (entry.name == name) return &entry;
+    return nullptr;
+}
+
+} // namespace
+
+void register_shell(std::string name, ShellFactory factory, std::string description) {
+    for (Entry &entry : registry()) {
+        if (entry.name == name) {
+            entry.factory = std::move(factory);
+            entry.description = std::move(description);
+            return;
+        }
+    }
+    registry().push_back({std::move(name), std::move(description), std::move(factory)});
+}
+
+std::unique_ptr<Shell> make_shell(std::string_view name) {
+    const Entry *entry = find(name);
+    if (entry == nullptr || !entry->factory) return nullptr;
+    return entry->factory();
+}
+
+std::vector<std::string> shell_names() {
+    std::vector<std::string> names;
+    names.reserve(registry().size());
+    for (const Entry &entry : registry()) names.push_back(entry.name);
+    return names;
+}
+
+std::string shell_description(std::string_view name) {
+    const Entry *entry = find(name);
+    return entry != nullptr ? entry->description : std::string{};
+}
+
+std::string selected_shell() {
+    const char *name = portablekit::env("SHELL");
+    return name != nullptr && *name != '\0' ? std::string(name) : std::string("vulkan");
+}
+
+ShellRegistration::ShellRegistration(const char *name, const char *description, ShellFactory factory) {
+    register_shell(name, std::move(factory), description != nullptr ? description : "");
+}
+
+} // namespace portablekit::host
diff --git a/host/shell/shell.hpp b/host/shell/shell.hpp
new file mode 100644
index 0000000..66f9a3e
--- /dev/null
+++ b/host/shell/shell.hpp
@@ -0,0 +1,225 @@
+#pragma once
+
+// The shell seam: what is around the GE backend (gpu/ge_backend.hpp). A shell
+// owns the window (or none), the events and the pad the game reads, the input
+// script, the port's interface (Dear ImGui), the presenting of each flip's
+// image with its pacing and frame interpolation, and window captures. The HLE
+// (hle_media.cpp) and the interface layer (ui/) talk to a Shell and a
+// GeBackend and to nothing else.
+//
+// The shells:
+//   vulkan    the VulkanRenderer's window, pad, interface and presenting
+//             (vulkan_shell.cpp). The Vulkan GE backend draws with this
+//             shell's renderer, so it runs only in this shell.
+//   headless  no window and no GPU (headless_shell.cpp): the pad comes from the
+//             input script read at pad level, frame by frame as the flips are
+//             presented, and the script's shots are the GE backend's captures.
+// <prefix>_SHELL names the one to use (vulkan when unset or empty);
+// <prefix>_NO_RENDER always means the headless one. A shell in the game's own
+// sources adds itself with a ShellRegistration, linked into the program
+// directly, as a GE backend does.
+#include "gpu/ge_backend.hpp"
+#include "input/touch_controls.hpp"
+#include "settings/settings.hpp"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+union SDL_Event;
+struct SDL_Window;
+struct SDL_Gamepad;
+struct ImDrawData;
+
+namespace portablekit::host {
+
+// PSP pad state gathered from the keyboard, the mouse's buttons and the gamepad.
+struct PadState {
+    std::uint32_t buttons{};
+    std::uint8_t analog_x{0x80u};
+    std::uint8_t analog_y{0x80u};
+    // The HD release reads a second stick from the two SceCtrlData bytes after
+    // Ly, which the PSP itself left reserved. 0x80 is its centre: the guest
+    // skips its camera path entirely only when both bytes are exactly centred.
+    std::uint8_t right_x{0x80u};
+    std::uint8_t right_y{0x80u};
+};
+
+// The mouse the input script's events come from. With scripted input on,
+// only these reach the game, so a person moving the real pointer over the
+// window does not disturb a scripted run.
+inline constexpr std::uint32_t kScriptedMouse = 0xFFFFFF00u;
+
+// Relative mouse motion, in counts, while the pointer is captured for the game.
+struct MouseMotion {
+    float x{};
+    float y{};
+};
+
+// The camera the game itself set, read back from the view matrix it uploads.
+// Only filled while <prefix>_TRACE_CAMERA or <prefix>_FIND_CAMERA is on.
+struct CameraReading {
+    bool valid{};
+    float yaw{};    // degrees, from the direction the camera looks along
+    float pitch{};  // degrees
+    float turn{};   // degrees of yaw since the previous traced frame
+    std::array<float, 3> position{};
+    // The matrix itself, in the layout the game holds it in: the GE's twelve
+    // uploaded floats expanded to a 4x4, which is byte for byte the matrix the
+    // game passed to the GE.
+    std::array<float, 16> view{};
+};
+
+// What a shell is made with.
+struct ShellConfig {
+    // The window's title; empty for the shell's own (the Vulkan shell's is the
+    // program's name and the build label, gpu::default_window_title()).
+    std::string title;
+    // How a shell without a window captures the game's picture for
+    // capture_window() (the input script's `shot`): the GE backend's
+    // capture_frame(). A shell with a window captures its own.
+    std::function<bool(const std::string &path)> capture_frame;
+};
+
+class Shell {
+public:
+    Shell() = default;
+    Shell(const Shell &) = delete;
+    Shell &operator=(const Shell &) = delete;
+    virtual ~Shell() = default;
+
+    // Lifecycle.
+    // The name it is registered under.
+    [[nodiscard]] virtual const char *name() const noexcept = 0;
+    // Returns false and fills `error` when the shell cannot run (no window, no
+    // device).
+    virtual bool initialize(const ShellConfig &config, std::string &error) = 0;
+    virtual void shutdown() = 0;
+    [[nodiscard]] virtual bool available() const noexcept = 0;
+    // Whether there is a window: events, the interface and the frame
+    // interpolation's presents between flips exist only then.
+    [[nodiscard]] virtual bool has_window() const noexcept = 0;
+
+    // Events and input.
+    // Handles the window's events (and runs the input script's steps due);
+    // returns false once the window has been closed or the script quit.
+    virtual bool pump_events() = 0;
+    // Reads the devices again for pad() without handling window events: the
+    // game reads its pad each frame, and taking the state then instead of at
+    // the last flip saves up to a game frame of latency.
+    virtual void sample_pad() = 0;
+    [[nodiscard]] virtual PadState pad() const noexcept = 0;
+    // The mouse's motion gathered by the pumps since the last call, while the
+    // pointer was captured for the game.
+    [[nodiscard]] virtual MouseMotion take_mouse_motion() noexcept = 0;
+    // A camera drag on the touch screen since the last take, as a fraction of
+    // the screen's height.
+    [[nodiscard]] virtual MouseMotion take_touch_motion() noexcept = 0;
+    // The on-screen menu button was tapped since the last take.
+    [[nodiscard]] virtual bool take_touch_menu() noexcept = 0;
+    // The on-screen touch controls: shown once the screen is touched while the
+    // game runs, hidden again by a gamepad, the keyboard or a real mouse.
+    [[nodiscard]] virtual bool touch_controls_visible() const noexcept = 0;
+    [[nodiscard]] virtual const input::touch::Controls &touch_controls() const = 0;
+    // The pointer is captured for the game: hidden, and its motion and buttons
+    // go to the game.
+    [[nodiscard]] virtual bool mouse_captured() const noexcept = 0;
+    [[nodiscard]] virtual bool quit_requested() const noexcept = 0;
+    virtual void request_quit() noexcept = 0;
+    // While off, the game reads a neutral pad. Turning it back on ignores the
+    // buttons still held until they are released.
+    virtual void set_game_input(bool enabled) = 0;
+    // An interface screen is up: the pointer stays free for it.
+    virtual void set_pointer_free(bool free) = 0;
+    // The input script (<prefix>_INPUT_SCRIPT) on a shell with a window: keys
+    // it holds reach the game as well as the interface, and with scripted
+    // input on, only the script's mouse reaches the game.
+    virtual void set_scripted_key(int position, bool down) = 0;
+    virtual void set_scripted_input(bool scripted) = 0;
+    // The port's own interface (host/ui). Every window event is offered to the
+    // hook first; returning true keeps it from the game.
+    virtual void set_event_hook(std::function<bool(const SDL_Event &)> hook) = 0;
+    // The pad the game reads, or null.
+    [[nodiscard]] virtual SDL_Gamepad *gamepad() const noexcept = 0;
+    // The window, or null without one.
+    [[nodiscard]] virtual SDL_Window *window() const noexcept = 0;
+
+    // Presenting.
+    // Shows `image`, the GE backend's display target at `display_address`
+    // (GeBackend::present_image), at the guest's flip. `moment` is the real
+    // time the flip's emulated time stands for (Kernel::real_time_of). Returns
+    // whether the flip itself presented the frame (with frame interpolation,
+    // the presents that follow show it).
+    virtual bool present(const gpu::PresentedImage &image, std::uint32_t display_address,
+                         std::optional<std::chrono::steady_clock::time_point> moment) = 0;
+    // Frame interpolation: the kernel calls present_due() while the game's code
+    // runs, and present_until() while it waits for real time.
+    virtual void present_due() = 0;
+    virtual void present_until(std::chrono::steady_clock::time_point wake) = 0;
+    // Drops the presents scheduled, as the game pauses.
+    virtual void pause_interpolation() = 0;
+    // A load running faster than real time: only some flips reach the window.
+    virtual void set_fast_forward(bool on) = 0;
+    // While held, the window keeps showing the frame on screen when hold began.
+    virtual void hold_frame(bool hold) = 0;
+    // Writes the next presented image, with the interface over it, as a BMP.
+    virtual void capture_window(const std::string &path) = 0;
+    // The shape the game's 3D view should have, width over height.
+    [[nodiscard]] virtual float game_aspect() const noexcept = 0;
+    // The refresh rate of the window's display, 0 when unknown.
+    [[nodiscard]] virtual float display_refresh() const noexcept = 0;
+    // The rate frames are presented at now.
+    [[nodiscard]] virtual double frame_rate_now() const noexcept = 0;
+    virtual void set_frame_rate(settings::FrameRate rate) = 0;
+    virtual void set_frame_rate_auto(bool automatic) = 0;
+    virtual void set_window_scale(std::uint32_t scale) = 0;
+    virtual void set_fullscreen(bool fullscreen) = 0;
+    virtual void set_present_mode(settings::PresentMode mode) = 0;
+    [[nodiscard]] virtual bool supports_present_mode(settings::PresentMode mode) const = 0;
+    virtual void set_aspect(settings::Aspect aspect) = 0;
+    virtual void set_sharp_screen(bool sharp) = 0;
+    virtual void set_perf_overlay(bool visible) = 0;
+    [[nodiscard]] virtual std::string device_name() const = 0;
+
+    // Interface (Dear ImGui), on a shell with a window. The caller has made the
+    // ImGui context and loaded its fonts; initialize_ui starts ImGui's SDL3
+    // platform backend for the window (the ImGui_ImplSDL3_InitFor... of the API
+    // the shell draws with) and the renderer backend, and on failure leaves
+    // neither running. shutdown_ui stops both.
+    virtual bool initialize_ui(std::string &error) = 0;
+    virtual void shutdown_ui() = 0;
+    // The renderer backend's NewFrame, before ImGui::NewFrame.
+    virtual void begin_ui_frame() = 0;
+    // Draw data from ImGui::Render, drawn over the next presented image.
+    virtual void set_ui_draw_data(ImDrawData *draw_data) = 0;
+    // Presents a frame outside the game's own flips: the last game frame when
+    // there is one and `show_game` is set, a plain background otherwise, with
+    // the interface over it.
+    virtual void present_ui(bool show_game) = 0;
+};
+
+using ShellFactory = std::function<std::unique_ptr<Shell>()>;
+
+// Adds a shell under `name`; a later registration of the same name replaces it.
+void register_shell(std::string name, ShellFactory factory, std::string description = {});
+// A new, uninitialised shell, or null when no shell has that name.
+[[nodiscard]] std::unique_ptr<Shell> make_shell(std::string_view name);
+// The registered names, in the order they were registered.
+[[nodiscard]] std::vector<std::string> shell_names();
+[[nodiscard]] std::string shell_description(std::string_view name);
+// The shell <prefix>_SHELL names; "vulkan" when it is unset or empty.
+[[nodiscard]] std::string selected_shell();
+
+// One line in a shell's source file registers it before main():
+//   const ShellRegistration registration("headless", "no window", [] { return std::make_unique<HeadlessShell>(); });
+struct ShellRegistration {
+    ShellRegistration(const char *name, const char *description, ShellFactory factory);
+};
+
+} // namespace portablekit::host

 // display address's target first (VulkanRenderer::upload_frame), then shown by
 // the same present: how a non-Vulkan backend's picture reaches the window, at
 // the cost of a copy a frame.
+//
+// initialize_ui(): ImGui's SDL3 platform backend for the renderer's window
+// (ImGui_ImplSDL3_InitForVulkan, which the interface layer called itself before
+// each shell chose its own), then the renderer's ImGui Vulkan backend.
 #include "shell/vulkan_shell.hpp"
 
 #include "gpu/vulkan_renderer.hpp"
 
+#include "backends/imgui_impl_sdl3.h"

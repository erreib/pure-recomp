 #include <memory>
 #include <utility>
 
@@ -85,8 +91,25 @@ public:
     void set_perf_overlay(bool visible) override { renderer_->set_perf_overlay(visible); }
     std::string device_name() const override { return renderer_->device_name(); }
 
-    bool initialize_ui(std::string &error) override { return renderer_->initialize_ui(error); }
-    void shutdown_ui() override { renderer_->shutdown_ui(); }
+    bool initialize_ui(std::string &error) override {
+        if (!ui_platform_) {
+            if (!ImGui_ImplSDL3_InitForVulkan(renderer_->window())) {
+                error = "ImGui_ImplSDL3_InitForVulkan failed";
+                return false;
+            }
+            ui_platform_ = true;
+        }
+        if (renderer_->initialize_ui(error)) return true;
+        ImGui_ImplSDL3_Shutdown();
+        ui_platform_ = false;
+        return false;
+    }
+    void shutdown_ui() override {
+        renderer_->shutdown_ui();
+        if (!ui_platform_) return;
+        ImGui_ImplSDL3_Shutdown();
+        ui_platform_ = false;
+    }
     void begin_ui_frame() override { renderer_->begin_ui_frame(); }
     void set_ui_draw_data(ImDrawData *draw_data) override { renderer_->set_ui_draw_data(draw_data); }

+// The registers by name, as indices into a preset.
+enum ReverbReg : std::size_t {
+    dAPF1, dAPF2, vIIR, vCOMB1, vCOMB2, vCOMB3, vCOMB4, vWALL,
+    vAPF1, vAPF2, mLSAME, mRSAME, mLCOMB1, mRCOMB1, mLCOMB2, mRCOMB2,
+    dLSAME, dRSAME, mLDIFF, mRDIFF, mLCOMB3, mRCOMB3, mLCOMB4, mRCOMB4,
+    dLDIFF, dRDIFF, mLAPF1, mRAPF1, mLAPF2, mRAPF2, vLIN, vRIN,
+};
+
+// The 39-tap half-band filter the SPU resamples the reverb's input and output
+// with (psx-spx, "Reverb Buffer Resampling"). The odd taps are zero but the
+// centre one, so a 22050 Hz sample takes 20 taps and the centre.
+constexpr std::array<std::int32_t, 39> kReverbFir{
+    -0x0001, 0x0000, 0x0002, 0x0000, -0x000A, 0x0000, 0x0023, 0x0000, -0x0067, 0x0000, 0x010A, 0x0000, -0x0268,
+    0x0000, 0x0534, 0x0000, -0x0B90, 0x0000, 0x2806, 0x4000, 0x2806, 0x0000, -0x0B90, 0x0000, 0x0534, 0x0000,
+    -0x0268, 0x0000, 0x010A, 0x0000, -0x0067, 0x0000, 0x0023, 0x0000, -0x000A, 0x0000, 0x0002, 0x0000, -0x0001,
+};
+
+// A product of the reverb divided by 8000h, as the SPU does.
+[[nodiscard]] constexpr std::int32_t reverb_mul(std::int32_t sample, std::int32_t volume) noexcept {
+    return (sample * volume) >> 15;
+}

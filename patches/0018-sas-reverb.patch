 void SasCore::init(std::uint32_t grain, std::uint32_t max_voices, std::uint32_t output_mode) {
     grain_ = grain != 0u && grain <= 2048u ? grain : 256u;
     max_voices_ = std::clamp(max_voices, 1u, kSasMaxVoices);
     output_mode_ = output_mode;
     voices_ = {};
+    reverb_ = SasReverb{};
+    wet_left_ = 0;
+    wet_right_ = 0;
+    dry_on_ = true;
+    wet_on_ = false;
+}

+void SasReverb::set_type(std::int32_t type) {
+    if (type < 0 || type >= kTypeCount) type = 0;
+    if (type == type_ && !ring_.empty()) return;
+    type_ = type;
+    ring_.assign(kReverbPresets[static_cast<std::size_t>(type)].bytes / 2u, 0);
+    position_ = 0u;
+    down_left_ = {};
+    down_right_ = {};
+    up_left_ = {};
+    up_right_ = {};
+    down_index_ = 0u;
+    up_index_ = 0u;
+    odd_frame_ = false;
+    configure();
+}
+
+void SasReverb::set_param(std::int32_t delay, std::int32_t feedback) {
+    delay_ = std::clamp(delay, 0, 127);
+    feedback_ = std::clamp(feedback, 0, 127);
+    configure();
+}
+
+// The preset of the type, with ECHO's and DELAY's echo shaped by RevParam. The
+// documentation gives those two tables only for one delay and one feedback,
+// so this follows what the tables themselves show: the echo is the distance
+// from the same-side write (mLSAME, mRSAME) down to the reads that feed it
+// back and out (dLSAME, mLCOMB1 and the right ones), FFAh units in both
+// tables, taken here as delay 127; the feedback is vWALL, -7F00h (8100h) in
+// ECHO and 0 in DELAY, so -(feedback << 8).
+void SasReverb::configure() {
+    regs_ = kReverbPresets[static_cast<std::size_t>(type_)].regs;
+    if (type_ != 7 && type_ != 8) return;
+    const auto distance = static_cast<std::uint16_t>(std::max(1, 0xFFA * delay_ / 127));
+    regs_[dLSAME] = regs_[mLCOMB1] = static_cast<std::uint16_t>(regs_[mLSAME] - distance);
+    regs_[dRSAME] = regs_[mRCOMB1] = static_cast<std::uint16_t>(regs_[mRSAME] - distance);
+    regs_[vWALL] = static_cast<std::uint16_t>(-(feedback_ << 8));
+}
+
+// One 22050 Hz step of the SPU formula (psx-spx, "SPU Reverb Formula"), in the
+// documented order of reads and writes. Offsets are 8-byte units, four 16-bit
+// samples each; "-2" bytes is the previous sample. Every intermediate value
+// saturates to 16 bits, as the documentation measured.
+void SasReverb::tick(std::int32_t in_left, std::int32_t in_right, std::int32_t &out_left, std::int32_t &out_right) {
+    const auto size = static_cast<std::int64_t>(ring_.size());
+    const auto at = [&](std::size_t reg, std::int32_t back = 0) -> std::int16_t & {
+        std::int64_t index = (static_cast<std::int64_t>(position_) + static_cast<std::int64_t>(regs_[reg]) * 4 - back) % size;
+        if (index < 0) index += size;
+        return ring_[static_cast<std::size_t>(index)];
+    };
+    const auto apf_at = [&](std::size_t reg, std::size_t disp) -> std::int16_t & {
+        std::int64_t index = (static_cast<std::int64_t>(position_) +
+                              (static_cast<std::int64_t>(regs_[reg]) - static_cast<std::int64_t>(regs_[disp])) * 4) % size;
+        if (index < 0) index += size;
+        return ring_[static_cast<std::size_t>(index)];
+    };
+    const auto vol = [&](std::size_t reg) { return static_cast<std::int32_t>(static_cast<std::int16_t>(regs_[reg])); };
+    const auto sat = [](std::int32_t value) { return clamp16(value); };
+
+    const std::int32_t lin = sat(reverb_mul(in_left, vol(vLIN)));
+    const std::int32_t rin = sat(reverb_mul(in_right, vol(vRIN)));
+    const std::int32_t iir = vol(vIIR);
+    const std::int32_t wall = vol(vWALL);
+
+    // Same side reflection, then the different side one.
+    const std::int32_t l_same_in = at(dLSAME);
+    const std::int32_t r_same_in = at(dRSAME);
+    const std::int32_t l_same_prev = at(mLSAME, 1);
+    const std::int32_t r_same_prev = at(mRSAME, 1);
+    const std::int32_t l_diff_in = at(dRDIFF);
+    const std::int32_t r_diff_in = at(dLDIFF);
+    const auto reflect = [&](std::int32_t input, std::int32_t wall_in, std::int32_t previous) {
+        const std::int32_t x = sat(sat(input + reverb_mul(wall_in, wall)) - previous);
+        return static_cast<std::int16_t>(sat(reverb_mul(x, iir) + previous));
+    };
+    at(mLSAME) = reflect(lin, l_same_in, l_same_prev);
+    at(mRSAME) = reflect(rin, r_same_in, r_same_prev);
+    const std::int32_t l_diff_prev = at(mLDIFF, 1);
+    const std::int32_t r_diff_prev = at(mRDIFF, 1);
+    const std::int32_t l_comb1 = at(mLCOMB1);
+    const std::int32_t r_comb1 = at(mRCOMB1);
+    at(mLDIFF) = reflect(lin, l_diff_in, l_diff_prev);
+    at(mRDIFF) = reflect(rin, r_diff_in, r_diff_prev);
+
+    // Early echo: the four combs.
+    std::int32_t lout = sat(reverb_mul(l_comb1, vol(vCOMB1)) + reverb_mul(at(mLCOMB2), vol(vCOMB2)) +
+                            reverb_mul(at(mLCOMB3), vol(vCOMB3)) + reverb_mul(at(mLCOMB4), vol(vCOMB4)));
+    std::int32_t rout = sat(reverb_mul(r_comb1, vol(vCOMB1)) + reverb_mul(at(mRCOMB2), vol(vCOMB2)) +
+                            reverb_mul(at(mRCOMB3), vol(vCOMB3)) + reverb_mul(at(mRCOMB4), vol(vCOMB4)));
+
+    // Late reverb: two all-pass filters.
+    const std::int32_t apf1 = vol(vAPF1);
+    const std::int32_t apf2 = vol(vAPF2);
+    const std::int32_t l_apf1 = apf_at(mLAPF1, dAPF1);
+    const std::int32_t r_apf1 = apf_at(mRAPF1, dAPF1);
+    const std::int32_t l_apf2 = apf_at(mLAPF2, dAPF2);
+    const std::int32_t r_apf2 = apf_at(mRAPF2, dAPF2);
+    lout = sat(lout - reverb_mul(apf1, l_apf1));
+    rout = sat(rout - reverb_mul(apf1, r_apf1));
+    at(mLAPF1) = static_cast<std::int16_t>(lout);
+    at(mRAPF1) = static_cast<std::int16_t>(rout);
+    lout = sat(reverb_mul(lout, apf1) + l_apf1);
+    rout = sat(reverb_mul(rout, apf1) + r_apf1);
+    lout = sat(lout - reverb_mul(apf2, l_apf2));
+    rout = sat(rout - reverb_mul(apf2, r_apf2));
+    at(mLAPF2) = static_cast<std::int16_t>(lout);
+    at(mRAPF2) = static_cast<std::int16_t>(rout);
+    lout = sat(reverb_mul(lout, apf2) + l_apf2);
+    rout = sat(reverb_mul(rout, apf2) + r_apf2);
+
+    out_left = lout;
+    out_right = rout;
+    position_ = position_ + 1u >= ring_.size() ? 0u : position_ + 1u;
+}
+
+void SasReverb::process(const std::int32_t *send, std::int32_t *wet, std::size_t frames) {
+    static const bool spu_rate = portablekit::env("SAS_REVERB_SPU_RATE") != nullptr;
+    if (!spu_rate) {
+        for (std::size_t frame = 0; frame < frames; ++frame) {
+            const std::size_t slot = frame * 2u;
+            tick(clamp16(send[slot]), clamp16(send[slot + 1u]), wet[slot], wet[slot + 1u]);
+        }
+        return;
+    }
+    // A 22050 Hz step on every other frame: the input filtered down from the
+    // newest 39 sends, the output filtered up from the newest 20 steps. On the
+    // frames between, the upsampler's centre tap lands on a step and passes it
+    // through; on the step's own frame its 20 side taps interpolate.
+    for (std::size_t frame = 0; frame < frames; ++frame) {
+        const std::size_t slot = frame * 2u;
+        down_index_ = (down_index_ + 1u) & 63u;
+        down_left_[down_index_] = down_left_[down_index_ + 64u] = static_cast<std::int16_t>(clamp16(send[slot]));
+        down_right_[down_index_] = down_right_[down_index_ + 64u] = static_cast<std::int16_t>(clamp16(send[slot + 1u]));
+        odd_frame_ = !odd_frame_;
+        if (odd_frame_) {
+            // The newest of the 39 is at down_index_ + 64, the oldest 38 before it.
+            const std::int16_t *left = &down_left_[down_index_ + 64u - 38u];
+            const std::int16_t *right = &down_right_[down_index_ + 64u - 38u];
+            std::int32_t sum_left = 0;
+            std::int32_t sum_right = 0;
+            for (std::size_t tap = 0; tap < kReverbFir.size(); tap += 2u) {
+                sum_left += left[tap] * kReverbFir[tap];
+                sum_right += right[tap] * kReverbFir[tap];
+            }
+            sum_left += left[19] * kReverbFir[19];
+            sum_right += right[19] * kReverbFir[19];
+            std::int32_t out_left = 0;
+            std::int32_t out_right = 0;
+            tick(clamp16(sum_left >> 15), clamp16(sum_right >> 15), out_left, out_right);
+            up_index_ = (up_index_ + 1u) & 63u;
+            up_left_[up_index_] = up_left_[up_index_ + 64u] = static_cast<std::int16_t>(out_left);
+            up_right_[up_index_] = up_right_[up_index_ + 64u] = static_cast<std::int16_t>(out_right);
+            // The zero-stuffed signal has a step here, so the even taps meet
+            // the newest 20 steps: the interpolated half-sample.
+            const std::int16_t *steps_left = &up_left_[up_index_ + 64u - 19u];
+            const std::int16_t *steps_right = &up_right_[up_index_ + 64u - 19u];
+            std::int32_t up_left = 0;
+            std::int32_t up_right = 0;
+            for (std::size_t step = 0; step < 20u; ++step) {
+                up_left += steps_left[step] * kReverbFir[2u * step];
+                up_right += steps_right[step] * kReverbFir[2u * step];
+            }
+            wet[slot] = clamp16(up_left >> 14);
+            wet[slot + 1u] = clamp16(up_right >> 14);
+        } else {
+            // The centre tap meets the step nine before the newest: itself.
+            wet[slot] = up_left_[(up_index_ + 64u - 9u) & 127u];
+            wet[slot + 1u] = up_right_[(up_index_ + 64u - 9u) & 127u];
+        }
+    }
+}

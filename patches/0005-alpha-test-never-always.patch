index f180930..3a2c238 100644
--- a/host/gpu/shaders/ge.frag
+++ b/host/gpu/shaders/ge.frag
@@ -9,9 +9,9 @@ layout(location = 0) out vec4 out_color;
 
 layout(set = 0, binding = 0) uniform sampler2D guest_texture;
 
-// False for pipelines of draws without an alpha test (texture_params.w 0):
-// the discard below is then compiled out, so tiled GPUs keep their early
-// depth test and hidden surface removal for them.
+// False for pipelines of draws without an alpha test, or with ALWAYS
+// (texture_params.w 1): the discard below is then compiled out, so tiled GPUs
+// keep their early depth test and hidden surface removal for them.
 layout(constant_id = 0) const bool kAlphaTest = true;
 
 layout(push_constant) uniform Push {
@@ -60,7 +60,11 @@ void main() {
     color.rgb = min(color.rgb + frag_specular, vec3(1.0));
     if ((int(push.viewport.w + 0.5) & 1) != 0) color.rgb = mix(lighting.fog_color.rgb, color.rgb, clamp(frag_fog, 0.0, 1.0));
 
-    // PSP alpha test, evaluated per fragment.
+    // PSP alpha test, evaluated per fragment. The function is the GE's own
+    // number, as for the depth test: 0 NEVER, 1 ALWAYS, then EQUAL, NOTEQUAL,
+    // LESS, LEQUAL, GREATER, GEQUAL. Reading 1 as "never" discarded every
+    // draw that enables the test with ALWAYS, which a game can do for most of
+    // its world.
     if (!kAlphaTest) {
         out_color = color;
         return;
@@ -69,7 +73,7 @@ void main() {
     float reference = push.texture_params.z / 255.0;
     float alpha = color.a;
     bool passed = true;
-    if (alpha_function == 1) passed = false;                     // never
+    if (alpha_function == 0) passed = false;                     // never
     else if (alpha_function == 2) passed = abs(alpha - reference) < 0.002;
     else if (alpha_function == 3) passed = abs(alpha - reference) >= 0.002;
     else if (alpha_function == 4) passed = alpha < reference;

+bool parse_choice(const char *text, std::size_t count, std::uint32_t &out) {
+    char *end = nullptr;
+    const unsigned long value = std::strtoul(text, &end, 10);
+    if (end == text || *end != '\0' || value >= count) return false;
+    out = static_cast<std::uint32_t>(value);
+    return true;
+}
+
+// The value of the game's option `index`, kept in Settings::game_options; a
+// Settings made without defaults_for() gets the options' defaults first.
+std::uint32_t &game_option_value(Settings &s, std::size_t index) {
+    const std::span<const GameOption> options = game().options;
+    while (s.game_options.size() < options.size())
+        s.game_options.push_back(options[s.game_options.size()].default_choice);
+    return s.game_options[index];
+}

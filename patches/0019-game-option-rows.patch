+// The tabs of the in-game menu, for the rows a game adds (GameOption::tab).
+enum class MenuTab { Video, Audio, Controls, Network, System };
+
+// A setting of the game's own: a row of the in-game menu that cycles through
+// its choices, in a "Game" section at the end of the tab it names. Its value
+// is an index into the choices, kept in settings.ini as game.<key>=<index>;
+// <prefix>_<KEY> (the key upper-cased) decides it for one run, as the
+// framework's own variables do. The port reads it with
+// settings::game_option(key).
+struct GameOption {
+    const char *key;                       // settings.ini without "game.": lower snake case, e.g. "fast_intro"
+    const char *label;                     // the row's text
+    std::span<const char *const> choices;  // the texts the row cycles through
+    const char *description;               // the row's help text
+    std::uint32_t default_choice = 0u;     // an index into choices
+    MenuTab tab = MenuTab::Video;          // the tab that shows the row
+};
+

+void Menu::game_rows(Tab tab) {
+    const std::span<const GameOption> options = portablekit::game().options;
+    settings::Settings &s = settings::current();
+    bool shown = false;
+    for (std::size_t i = 0; i < options.size(); ++i) {
+        const GameOption &option = options[i];
+        if (option.tab != tab || option.choices.empty()) continue;
+        if (!shown) section("Game");
+        shown = true;
+        const int count = static_cast<int>(option.choices.size());
+        const int current = std::min(static_cast<int>(settings::game_option(option.key)), count - 1);
+        const std::string key = std::string("game.") + option.key;
+        if (const int delta = choice_row(option.label, option.choices[static_cast<std::size_t>(current)],
+                                         options_for(key.c_str(), option.description));
+            delta != 0 && i < s.game_options.size()) {
+            s.game_options[i] = static_cast<std::uint32_t>(cycle(current, delta, count));
+            settings::save();
+        }
+    }
+}
+
+void Menu::restore_game_rows(Tab tab) {
+    const std::span<const GameOption> options = portablekit::game().options;
+    settings::Settings &s = settings::current();
+    for (std::size_t i = 0; i < options.size() && i < s.game_options.size(); ++i) {
+        const std::string key = std::string("game.") + options[i].key;
+        if (options[i].tab == tab && settings::overridden_by(key.c_str()).empty())
+            s.game_options[i] = options[i].default_choice;
+    }
+}
+

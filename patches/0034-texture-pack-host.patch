--- /dev/null
+++ b/host/gpu/texture_pack_host.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <string>
+
+namespace portablekit::gpu {
+
+// What the menu's Texture pack row and the import screen ask of whatever
+// draws texture packs (texture_pack.hpp): the Vulkan renderer, or a GE
+// backend of a port's own shell, which the shell registers
+// (set_active_texture_pack_host(), hle_common.hpp).
+class TexturePackHost {
+public:
+    virtual ~TexturePackHost() = default;
+    // Draws an installed HD texture pack's images instead of the game's own
+    // textures. Takes effect from the next frame; off draws exactly what no
+    // pack would.
+    virtual void set_texture_pack(bool enabled) = 0;
+    // For the menu: "Off", "Not installed", or how many textures the pack has
+    // and how many of them are on the GPU.
+    [[nodiscard]] virtual std::string texture_pack_status() const = 0;
+    // Opens the pack again from the next frame, e.g. after an import.
+    virtual void reload_texture_pack() = 0;
+    // While held, no pack is open, so an import can move its folder; true
+    // from texture_pack_held() once the pack has been closed.
+    virtual void hold_texture_pack(bool hold) = 0;
+    [[nodiscard]] virtual bool texture_pack_held() const = 0;
+    // The folder the pack is read from (texture_pack_import.hpp): the
+    // installed one, textures/<disc id> in the data directory, or the one the
+    // player uses in place or <prefix>_TEXTURE_PACK names.
+    [[nodiscard]] virtual std::string texture_pack_folder() const = 0;
+};
+
+} // namespace portablekit::gpu

+bool VulkanRenderer::Impl::create_depth_readback(VkDeviceSize bytes, std::string &error) {
+    VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    buffer_info.size = bytes;
+    buffer_info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    buffer_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (!check(vkCreateBuffer(device, &buffer_info, nullptr, &depth_readback.buffer), "vkCreateBuffer", error))
+        return false;
+    VkMemoryRequirements requirements{};
+    vkGetBufferMemoryRequirements(device, depth_readback.buffer, &requirements);
+    // The CPU reads it, so cached memory first, as for the frame write-back.
+    VkPhysicalDeviceMemoryProperties memory_properties{};
+    vkGetPhysicalDeviceMemoryProperties(physical_device, &memory_properties);
+    constexpr VkMemoryPropertyFlags kVisible = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+    std::int32_t chosen = -1;
+    for (const VkMemoryPropertyFlags wanted :
+         {kVisible | VK_MEMORY_PROPERTY_HOST_CACHED_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+          kVisible | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, kVisible | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT}) {
+        for (std::uint32_t i = 0; i < memory_properties.memoryTypeCount && chosen < 0; ++i)
+            if ((requirements.memoryTypeBits & (1u << i)) != 0u &&
+                (memory_properties.memoryTypes[i].propertyFlags & wanted) == wanted)
+                chosen = static_cast<std::int32_t>(i);
+        if (chosen >= 0) break;
+    }
+    if (chosen < 0) {
+        error = "no host-visible memory type";
+        return false;
+    }
+    depth_readback_coherent =
+        (memory_properties.memoryTypes[chosen].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0u;
+    VkMemoryAllocateInfo allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    allocate.allocationSize = requirements.size;
+    allocate.memoryTypeIndex = static_cast<std::uint32_t>(chosen);
+    if (!check(vkAllocateMemory(device, &allocate, nullptr, &depth_readback.memory), "vkAllocateMemory", error))
+        return false;
+    vkBindBufferMemory(device, depth_readback.buffer, depth_readback.memory, 0u);
+    if (!check(vkMapMemory(device, depth_readback.memory, 0u, bytes, 0u, &depth_readback.mapped), "vkMapMemory",
+               error))
+        return false;
+    depth_readback_size = bytes;
+    return true;
+}
+
+void VulkanRenderer::Impl::destroy_depth_readback() {
+    if (depth_readback.mapped != nullptr) vkUnmapMemory(device, depth_readback.memory);
+    vkDestroyBuffer(device, depth_readback.buffer, nullptr);
+    vkFreeMemory(device, depth_readback.memory, nullptr);
+    depth_readback = Staging{};
+    depth_readback_size = 0u;
+}
+
+bool VulkanRenderer::write_back_depth(std::uint32_t color_address, std::uint32_t depth_address,
+                                      std::uint32_t depth_stride, GuestMemory &memory, const char *why) {
+    Impl &impl = *impl_;
+    if (!impl.ready) return false;
+    const auto found = impl.targets.find(color_address);
+    if (found == impl.targets.end() || !found->second.initialized) return false;
+    // The GE's depth buffer always lies in VRAM. Only screen-wide buffers are
+    // written, as for the frame write-back (record_writeback): a narrower one,
+    // a render-to-texture target's, has no height the GE states, and 272 rows
+    // of it could run over whatever the game keeps after it.
+    depth_address = 0x04000000u | (depth_address & 0x001FFFF0u);
+    if (depth_stride < kPspWidth) return false;
+    const std::size_t guest_bytes = static_cast<std::size_t>(depth_stride) * kPspHeight * 2u;
+    std::uint8_t *out = memory.raw_pointer(depth_address, guest_bytes);
+    if (out == nullptr) return false;
+    // Bytes per texel of the depth aspect copied into a buffer.
+    std::uint32_t texel_bytes = 4u;
+    switch (impl.depth_format) {
+    case VK_FORMAT_D32_SFLOAT:
+    case VK_FORMAT_D32_SFLOAT_S8_UINT:
+    case VK_FORMAT_D24_UNORM_S8_UINT:
+    case VK_FORMAT_X8_D24_UNORM_PACK32: break;
+    case VK_FORMAT_D16_UNORM: texel_bytes = 2u; break;
+    default: return false;
+    }
+    const perf::Clock::time_point start = perf::Clock::now();
+    if (!impl.recording) begin_frame();
+    impl.end_pass();
+    const VkExtent2D extent = impl.target_extent;
+    const VkDeviceSize bytes = static_cast<VkDeviceSize>(extent.width) * extent.height * texel_bytes;
+    if (impl.depth_readback_size < bytes) {
+        impl.destroy_depth_readback();
+        std::string error;
+        if (!impl.create_depth_readback(bytes, error)) {
+            static bool reported = false;
+            if (!std::exchange(reported, true))
+                std::cout << "[render] cannot write depth back to guest memory: " << error << "\n";
+            impl.destroy_depth_readback();
+            return false;
+        }
+    }
+    Impl::Target &target = found->second;
+    impl.transition(impl.command_buffer, target.depth, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+                    VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, impl.depth_aspect());
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT, 0u, 0u, 1u};
+    copy.imageExtent = {extent.width, extent.height, 1u};
+    vkCmdCopyImageToBuffer(impl.command_buffer, target.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                           impl.depth_readback.buffer, 1u, &copy);
+    VkBufferMemoryBarrier to_host{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    to_host.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    to_host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    to_host.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_host.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_host.buffer = impl.depth_readback.buffer;
+    to_host.offset = 0u;
+    to_host.size = VK_WHOLE_SIZE;
+    vkCmdPipelineBarrier(impl.command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0u, 0u,
+                         nullptr, 1u, &to_host, 0u, nullptr);
+    impl.transition(impl.command_buffer, target.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                    VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, impl.depth_aspect());
+    perf::count_target_copy();
+
+    // Run everything recorded so far and carry on recording afterwards, as
+    // read_back_framebuffer() does.
+    impl.end_gpu_segment(impl.command_buffer);
+    vkEndCommandBuffer(impl.command_buffer);
+    std::array<VkCommandBuffer, 2> batch{};
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.commandBufferCount = impl.frame_batch(impl.command_buffer, batch);
+    submit.pCommandBuffers = batch.data();
+    const perf::Clock::time_point wait_start = perf::Clock::now();
+    vkQueueSubmit(impl.queue, 1u, &submit, impl.frame_fence);
+    impl.wait_fence(impl.frame_fence, "a depth write-back");
+    const perf::Clock::duration waited = perf::Clock::now() - wait_start;
+    perf::add_wait_time(waited, perf::Stall::Readback);
+    vkResetFences(impl.device, 1u, &impl.frame_fence);
+    // Uploads and evictions recorded so far have finished with the frame.
+    impl.release_frame_uploads(impl.slot);
+    vkResetCommandBuffer(impl.command_buffer, 0u);
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(impl.command_buffer, &begin);
+    impl.breadcrumb(impl.command_buffer, "frame goes on after a depth write-back");
+    impl.begin_gpu_segment(impl.command_buffer);
+    // A frame recorded for drawing again keeps what it wrote so far.
+    if (!impl.interpolating) impl.enter_region(impl.frame_region);
+    impl.environment_version = 0u;
+    impl.object_valid = false;
+    impl.raw_valid = false;
+    impl.forget_bindings();
+
+    // The GE's 16-bit z of each PSP pixel, from the texel at its centre. The
+    // GE's z reaches the depth image as z / 65535 (the vertex shader and the
+    // Vulkan viewport's depth range), so it is the texel times 65535.
+    if (!impl.depth_readback_coherent) {
+        VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+        range.memory = impl.depth_readback.memory;
+        range.offset = 0u;
+        range.size = VK_WHOLE_SIZE;
+        vkInvalidateMappedMemoryRanges(impl.device, 1u, &range);
+    }
+    const auto *texels = static_cast<const std::uint8_t *>(impl.depth_readback.mapped);
+    const auto centre = [](std::uint32_t pixel, std::uint32_t pixels, std::uint32_t texels_across) {
+        const float at = (static_cast<float>(pixel) + 0.5f) * static_cast<float>(texels_across) /
+                         static_cast<float>(pixels);
+        return std::min(static_cast<std::uint32_t>(at), texels_across - 1u);
+    };
+    std::array<std::uint32_t, kPspWidth> columns{};
+    for (std::uint32_t x = 0; x < kPspWidth; ++x) columns[x] = centre(x, kPspWidth, extent.width);
+    const VkFormat format = impl.depth_format;
+    std::uint32_t lowest = 0xFFFFu;
+    std::uint32_t highest = 0u;
+    std::array<std::uint16_t, kPspWidth> row_values{};
+    for (std::uint32_t y = 0; y < kPspHeight; ++y) {
+        const std::uint8_t *row =
+            texels + static_cast<std::size_t>(centre(y, kPspHeight, extent.height)) * extent.width * texel_bytes;
+        for (std::uint32_t x = 0; x < kPspWidth; ++x) {
+            const std::uint8_t *texel = row + static_cast<std::size_t>(columns[x]) * texel_bytes;
+            std::uint32_t z = 0u;
+            if (format == VK_FORMAT_D16_UNORM) {
+                std::uint16_t value{};
+                std::memcpy(&value, texel, 2u);
+                z = value;
+            } else if (format == VK_FORMAT_D32_SFLOAT || format == VK_FORMAT_D32_SFLOAT_S8_UINT) {
+                float value{};
+                std::memcpy(&value, texel, 4u);
+                z = static_cast<std::uint32_t>(std::clamp(value, 0.0f, 1.0f) * 65535.0f + 0.5f);
+            } else {
+                std::uint32_t value{};
+                std::memcpy(&value, texel, 4u);
+                z = static_cast<std::uint32_t>(
+                    (static_cast<std::uint64_t>(value & 0x00FFFFFFu) * 65535u + 0x7FFFFFu) / 0xFFFFFFu);
+            }
+            lowest = std::min(lowest, z);
+            highest = std::max(highest, z);
+            row_values[x] = static_cast<std::uint16_t>(z);
+        }
+        // Guest memory is little-endian, as every host this runs on.
+        static_assert(std::endian::native == std::endian::little);
+        std::memcpy(out + static_cast<std::size_t>(y) * depth_stride * 2u, row_values.data(),
+                    static_cast<std::size_t>(kPspWidth) * 2u);
+    }
+    perf::note_stall(perf::Stall::Readback, perf::Clock::now() - start);
+    static bool announced = false;
+    if (!std::exchange(announced, true))
+        std::cout << "[render] depth written back to guest memory at 0x" << std::hex << depth_address << std::dec
+                  << " for " << why << " (" << portablekit::env_name("NO_DEPTH_READBACK") << " turns it off)\n";
+    static const bool trace = portablekit::env("TRACE_DEPTH_READBACK") != nullptr;
+    if (trace) {
+        const double total_ms = std::chrono::duration<double, std::milli>(perf::Clock::now() - start).count();
+        const double wait_ms = std::chrono::duration<double, std::milli>(waited).count();
+        std::cout << "[render] frame " << impl.frames << " " << why << ": depth of 0x" << std::hex << color_address
+                  << " written back to 0x" << depth_address << std::dec << " stride " << depth_stride << ", z "
+                  << lowest << "-" << highest << ", " << total_ms << " ms (GPU wait " << wait_ms << " ms)\n";
+    }
+    return true;
+}

+// Before a SIGNAL's handler runs: it may read the depth buffer with the CPU
+// (Wipeout Pure tests whether the sun is covered for its lens flare that
+// way), and the renderer keeps depth on the GPU, so the depth of the target
+// being drawn is written into guest VRAM where the GE would have left it.
+// <prefix>_NO_DEPTH_READBACK leaves guest memory alone.
+void write_back_depth_for_signal(Runtime &rt, std::uint32_t signal) {
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    static const bool disabled = portablekit::env("NO_DEPTH_READBACK") != nullptr;
+    if (disabled || !media().renderer || !media().renderer->available()) return;
+    const gpu::RenderTarget &target = media().ge.target();
+    char why[32];
+    std::snprintf(why, sizeof why, "signal 0x%X", signal);
+    media().renderer->write_back_depth(target.color_address, target.depth_address, target.depth_stride, rt.memory(),
+                                       why);
+#else
+    (void)rt;
+    (void)signal;
+#endif
+}

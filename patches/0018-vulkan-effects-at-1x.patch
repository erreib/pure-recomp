+// The texel of a target `texels` wide at the centre of PSP pixel `pixel` of
+// `pixels`: (pixel S + S/2) at an internal scale S, the pixel itself at 1x.
+// What guest memory is given of a scaled target, depth and colour alike, as
+// the Metal backend does (patch 0018).
+std::uint32_t centre_texel(std::uint32_t pixel, std::uint32_t pixels, std::uint32_t texels) {
+    const float at = (static_cast<float>(pixel) + 0.5f) * static_cast<float>(texels) / static_cast<float>(pixels);
+    return std::min(static_cast<std::uint32_t>(at), texels - 1u);
+}

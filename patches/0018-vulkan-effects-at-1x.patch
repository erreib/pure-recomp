+void VulkanRenderer::Impl::take_writeback(const FrameSlot &frame, std::uint32_t *pixels) {
+    invalidate_writeback(frame.writeback.memory);
+    const auto *rows = static_cast<const std::uint32_t *>(frame.writeback.mapped);
+    const std::uint32_t width = frame.writeback_width;
+    if (width == kPspWidth) {
+        std::memcpy(pixels, rows, static_cast<std::size_t>(kPspWidth) * kPspHeight * 4u);
+        return;
+    }
+    std::array<std::uint32_t, kPspWidth> columns{};
+    for (std::uint32_t x = 0; x < kPspWidth; ++x) columns[x] = centre_texel(x, kPspWidth, width);
+    for (std::uint32_t y = 0; y < kPspHeight; ++y) {
+        const std::uint32_t *row = rows + static_cast<std::size_t>(y) * width;
+        std::uint32_t *out = pixels + static_cast<std::size_t>(y) * kPspWidth;
+        for (std::uint32_t x = 0; x < kPspWidth; ++x) out[x] = row[columns[x]];
+    }
+}

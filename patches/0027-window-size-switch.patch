diff --git a/host/shell/shell.cpp b/host/shell/shell.cpp
index 291bcfb..61fc24a 100644
--- a/host/shell/shell.cpp
+++ b/host/shell/shell.cpp
@@ -3,6 +3,7 @@
 #include "../profile.hpp"
 #include "../registry.hpp"
 
+#include <cstdio>
 #include <utility>
 
 namespace portablekit::host {
@@ -27,6 +28,17 @@ std::string selected_shell() {
     return name != nullptr && *name != '\0' ? std::string(name) : std::string("vulkan");
 }
 
+bool window_size_switch(int &width, int &height) {
+    const char *size = portablekit::env("WINDOW_SIZE");
+    if (size == nullptr) return false;
+    int w = 0, h = 0;
+    char tail = 0;
+    if (std::sscanf(size, "%dx%d%c", &w, &h, &tail) != 2 || w < 1 || h < 1 || w > 16384 || h > 16384) return false;
+    width = w;
+    height = h;
+    return true;
+}
+
 ShellRegistration::ShellRegistration(const char *name, const char *description, ShellFactory factory) {
     register_shell(name, std::move(factory), description != nullptr ? description : "");
 }

+// What a game has of the features the in-game menu offers rows for (ui/menu.cpp). The menu draws a feature's rows
+// only when the game has it; hidden rows keep their settings. The defaults are the framework's first game's, which
+// has them all.
+struct MenuFeatures {
+    // Ad hoc play: the Network tab and the System tab's "Pause during multiplayer". Without it the wireless switch
+    // stays off: the menu turns it off when it opens.
+    bool adhoc = true;
+    // The HD release's right-stick camera: the Right stick row's Camera choice and the two camera inversion rows.
+    // Without it the right stick presses the D-pad or nothing.
+    bool right_stick_camera = true;
+    // A camera the mouse turns: the Mouse, Mouse sensitivity and the two mouse inversion rows. The bindings of keys
+    // and mouse buttons stay.
+    bool mouse_camera = true;
+};

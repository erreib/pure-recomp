+// <prefix>_MENU_DUMP (for tests): when the menu opens, its first frames draw
+// each tab once and print the tab's rows on the console, one line a tab:
+// "[menu] Video: Display, Window size, ...". Rows another screen's code draws
+// (the fonts, texture packs, saves) are one entry, "[font rows]". These are
+// the rows of the tab being drawn, while it is drawn.
+std::vector<std::string> *g_dumped_rows = nullptr;
+
+// Notes a row for the dump: its label without ImGui's "##" id part.
+void dump_row(const char *label) {
+    if (g_dumped_rows == nullptr) return;
+    const char *hidden = std::strstr(label, "##");
+    g_dumped_rows->emplace_back(label, hidden != nullptr ? hidden : label + std::strlen(label));
+}
+
+// Adds what the dump shows of the row noted last, such as the choices a
+// choice row offers: "Aspect ratio (Original / Stretch)".
+void dump_detail(const std::string &detail) {
+    if (g_dumped_rows != nullptr && !g_dumped_rows->empty()) g_dumped_rows->back() += " (" + detail + ")";
+}
+
+// The rows of widgets.hpp, noted for the dump as they are drawn. They are
+// objects, not functions, so that a call in this file finds them and not, by
+// argument-dependent lookup, widgets.hpp's own as well.
+struct ChoiceRow {
+    int operator()(const char *label, const std::string &value, const RowOptions &options = {}) const {
+        dump_row(label);
+        return ui::choice_row(label, value, options);
+    }
+};
+struct ToggleRow {
+    bool operator()(const char *label, bool value, const RowOptions &options = {}) const {
+        dump_row(label);
+        return ui::toggle_row(label, value, options);
+    }
+};
+struct SliderRow {
+    bool operator()(const char *label, int &value, int minimum, int maximum, int step, const char *format,
+                    const RowOptions &options = {}) const {
+        dump_row(label);
+        return ui::slider_row(label, value, minimum, maximum, step, format, options);
+    }
+};
+struct ButtonRow {
+    bool operator()(const char *label, const RowOptions &options = {}, ImU32 color = colors::kText) const {
+        dump_row(label);
+        return ui::button_row(label, options, color);
+    }
+};
+struct ValueRow {
+    bool operator()(const char *label, const std::string &value, const RowOptions &options = {}) const {
+        dump_row(label);
+        return ui::value_row(label, value, options);
+    }
+};
+struct InfoRow {
+    void operator()(const char *label, const std::string &value) const {
+        dump_row(label);
+        ui::info_row(label, value);
+    }
+};
+constexpr ChoiceRow choice_row{};
+constexpr ToggleRow toggle_row{};
+constexpr SliderRow slider_row{};
+constexpr ButtonRow button_row{};
+constexpr ValueRow value_row{};
+constexpr InfoRow info_row{};

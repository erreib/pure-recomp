+// and the top four bits of its mantissa (a piecewise linear log2, floored to
+// 1/16), of |x|. ge_log16 in vulkan_renderer.cpp.
+float ge_log16(float x) {
+    return float(int((floatBitsToUint(x) >> 19u) & 0xFFFu) - 127 * 16);
+}

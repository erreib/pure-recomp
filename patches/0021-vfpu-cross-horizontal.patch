+    // The cross product's lanes (task 048, patch 0021). Test mode: PPSSPP's JIT rounds both products of each lane
+    // and then their difference, nothing fused (every one of 1592532 sampled result lanes). Default: the PSP's rule,
+    // vfpu_dot's.
+    static float vfpu_cross_dot(const float *s, const float *t, std::uint32_t n) noexcept {
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#endif
+        if (vfpu_dot_mode() != 1u) return vfpu_dot_psp(s, t, n);
+        float r = s[0] * t[0];
+        for (std::uint32_t i = 1u; i < n; ++i) {
+            const float p = s[i] * t[i];
+            r = r + p;
+        }
+        return r;
+    }

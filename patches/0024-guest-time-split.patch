+namespace {
+
+constexpr std::size_t kGuestParts = static_cast<std::size_t>(GuestPart::Count);
+
+struct GuestSplit {
+    std::array<Clock::duration, kGuestParts> parts{};
+    std::uint64_t calls{};
+    Clock::duration excluded{};  // render and pacing, running total
+};
+
+GuestSplit &guest_split() {
+    static GuestSplit value;
+    return value;
+}
+
+// Prints the second's guest split per game frame. `guest_ms` is the [perf]
+// line's guest time per frame, `store_ms` the stores' per frame.
+void report_guest_split(double frames, double guest_ms, double store_ms) {
+    GuestSplit &split = guest_split();
+    if (frames <= 0.0) return;
+    const auto ms = [&](GuestPart part) { return to_ms(split.parts[static_cast<std::size_t>(part)]) / frames; };
+    double hle = 0.0;
+    for (std::size_t i = 0; i < kGuestParts; ++i) hle += ms(static_cast<GuestPart>(i));
+    std::printf("[guest-split] ms per game frame: game %.2f | kernel %.2f io %.2f sas %.2f audio %.2f ge %.2f "
+                "display %.2f other %.2f | store %.2f (in render) | guest %.2f hle %.2f calls %.0f\n",
+                std::max(0.0, guest_ms - hle), ms(GuestPart::Kernel), ms(GuestPart::Io), ms(GuestPart::Sas),
+                ms(GuestPart::Audio), ms(GuestPart::Ge), ms(GuestPart::Display), ms(GuestPart::Other), store_ms,
+                guest_ms, hle, static_cast<double>(split.calls) / frames);
+    std::fflush(stdout);
+    split.parts = {};
+    split.calls = 0u;
+}
+
+} // namespace
+
+bool guest_split_enabled() noexcept {
+    static const bool enabled = portablekit::env("TRACE_GUEST") != nullptr;
+    return enabled;
+}
+
+Clock::duration guest_excluded_time() noexcept { return guest_split().excluded; }
+
+void add_guest_split(GuestPart part, Clock::duration duration) noexcept {
+    GuestSplit &split = guest_split();
+    split.parts[static_cast<std::size_t>(part)] += duration;
+    ++split.calls;
+}
+
+void add_render_time(Clock::duration duration) {
+    state().render += duration;
+    if (guest_split_enabled()) guest_split().excluded += duration;
+}
 

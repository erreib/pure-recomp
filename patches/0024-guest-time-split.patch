+namespace {
+
+// The module family an import's time is charged to under <prefix>_TRACE_GUEST.
+perf::GuestPart guest_part(std::string_view library) {
+    const auto starts = [&](std::string_view prefix) { return library.starts_with(prefix); };
+    if (starts("ThreadMan") || starts("Kernel_Library") || starts("SysMem") || starts("UtilsFor") ||
+        starts("InterruptManager") || starts("ModuleMgr") || starts("LoadExec") || starts("sceSuspend") ||
+        starts("sceDmac"))
+        return perf::GuestPart::Kernel;
+    if (starts("IoFileMgr") || starts("sceUmd") || starts("StdioFor")) return perf::GuestPart::Io;
+    if (starts("sceSasCore")) return perf::GuestPart::Sas;
+    if (starts("sceAudio") || starts("sceAtrac") || starts("sceMp3") || starts("sceVaudio"))
+        return perf::GuestPart::Audio;
+    if (starts("sceGe_")) return perf::GuestPart::Ge;
+    if (starts("sceDisplay")) return perf::GuestPart::Display;
+    return perf::GuestPart::Other;
+}
+
+// Times one HLE call for the guest split: its wall time less the render and
+// pacing time inside it. A call made from inside another is the outer one's.
+HleFunction timed(HleFunction function, perf::GuestPart part) {
+    return [function = std::move(function), part](Runtime &rt, AllegrexContext &ctx) {
+        static int depth = 0;
+        if (depth != 0) {
+            function(rt, ctx);
+            return;
+        }
+        struct Scope {
+            perf::GuestPart part;
+            perf::Clock::time_point start{perf::Clock::now()};
+            perf::Clock::duration excluded{perf::guest_excluded_time()};
+            Scope(perf::GuestPart p) : part(p) { ++depth; }
+            ~Scope() {
+                --depth;
+                const perf::Clock::duration spent =
+                    (perf::Clock::now() - start) - (perf::guest_excluded_time() - excluded);
+                perf::add_guest_split(part, std::max(spent, perf::Clock::duration::zero()));
+            }
+        } scope(part);
+        function(rt, ctx);
+    };
+}
+
+} // namespace
+
 void HleRegistrar::bind(const std::string &library, std::uint32_t nid, HleFunction function) {
     bound_[{library, nid}] = function;
+    if (perf::guest_split_enabled()) function = timed(std::move(function), guest_part(library));
     runtime_.register_hle(library, nid, std::move(function));
 }
 

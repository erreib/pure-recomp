+// <prefix>_TRACE_GUEST: where the guest thread's time goes, as a
+// [guest-split] line once a second in milliseconds per game frame. "Guest"
+// is the [perf] line's: the frame less render and pacing. Each HLE call is
+// timed at its registration's wrapper (HleRegistrar::bind, installed only
+// when the trace is on, so off it costs nothing per call), less the render
+// and pacing time spent inside it, and charged to its module family; what is
+// left is "game", the recompiled code and the dispatch between imports.
+// "store" (the depth and frame stores into guest memory) happens inside
+// render calls and is shown for reference, outside the guest total.
+enum class GuestPart : std::uint8_t { Kernel, Io, Sas, Audio, Ge, Display, Other, Count };
+[[nodiscard]] bool guest_split_enabled() noexcept;
+// Render and pacing time so far, a running total the HLE wrapper reads
+// before and after a call to take them out of the call's own time.
+[[nodiscard]] Clock::duration guest_excluded_time() noexcept;
+void add_guest_split(GuestPart part, Clock::duration duration) noexcept;
+
 // Frame times in milliseconds, a ring written at `history_cursor()`.
 inline constexpr std::size_t kHistoryFrames = 192u;
 [[nodiscard]] const std::array<float, kHistoryFrames> &frame_history();

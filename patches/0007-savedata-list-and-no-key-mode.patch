+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+// The save list: the PSP's own save-data dialog for the requests in which the
+// player picks a save (LISTLOAD, LISTSAVE, LISTDELETE and the list delete; see
+// hle/hle_savedata.cpp), drawn over the running game as the PSP draws it: the
+// banner (Save, Load or Delete), a column of the saves' icons with the chosen
+// one large, and beside it the save's title, date, time and size, its savedata
+// title and its detail, or NEW DATA for a free slot. Choosing a save that
+// exists to save over or to delete asks first, with No chosen, as on a PSP;
+// then the dialog says what happened ("Save completed.") until a button closes
+// it.
+//
+// Gamepad: up and down choose, the PSP's Enter button picks (X, as the game
+// asks; the pad gives X where the game reads it, south unless the "Confirm
+// button" setting says otherwise), its Back button (O) or Triangle backs out.
+// Keyboard: the arrow keys, Enter and Esc. Mouse: click an entry to choose it,
+// click it again to pick it.
+//
+// The game keeps running behind it, as behind the PSP's dialog (it polls the
+// request's status every frame), but reads a neutral pad, and the window shows
+// whatever the game draws behind it (Wipeout Pure: a grey screen). Without an
+// interface (the headless shell) nothing opens and the request is answered at
+// once.
+namespace portablekit::ui {
+
+enum class SaveListKind { Load, Save, Delete };
+
+struct SaveListEntry {
+    std::string name;            // the save name, e.g. "P0001"
+    bool exists{};               // false: a free slot (LISTSAVE only)
+    std::string title;           // PARAM.SFO's TITLE
+    std::string savedata_title;  // SAVEDATA_TITLE
+    std::string detail;          // SAVEDATA_DETAIL, lines separated by '\n'
+    std::string date;            // "2026/10/07   14:03"
+    std::uint64_t size_kb{};
+    // ICON0.PNG, or the game's own icon for a free slot; may be empty.
+    std::vector<std::uint8_t> icon;
+};
+
+// What the dialog says once the load, save or delete has run.
+struct SaveListOutcome {
+    bool ok{};
+    std::string message;  // "Save completed.", or what went wrong
+    std::optional<SaveListEntry> saved;  // a save just written, shown in place of its entry
+};
+
+struct SaveListRequest {
+    SaveListKind kind{SaveListKind::Load};
+    std::vector<SaveListEntry> entries;
+    std::size_t focus{};  // the entry chosen when the list opens
+    // Enter is the PSP's X and Back its O (the game's dialog parameters say
+    // so with buttonSwap 1, as a Western PSP does); false: the other way.
+    bool enter_cross{true};
+    // Loads, saves or deletes entries[i] once the player has picked it (and
+    // confirmed writing over it or deleting it). Runs inside the game frame
+    // the choice is made in.
+    std::function<SaveListOutcome(std::size_t)> act;
+};
+
+// Called once when the list closes: the entry `act` ran on, or nullopt when
+// the player backed out (or the list was cancelled).
+using SaveListDone = std::function<void(std::optional<std::size_t>)>;
+
+// Opens the list over the running game; draw_over_game() draws it with every
+// game frame until it closes. False when there is no interface to draw it in.
+bool open_game_save_list(SaveListRequest request, SaveListDone on_done);
+[[nodiscard]] bool save_list_open();
+// Closes an open list as if the player had backed out.
+void cancel_save_list();
+// Builds this frame of the list and handles its input, inside an interface
+// frame.
+void save_list_frame();
+
+} // namespace portablekit::ui

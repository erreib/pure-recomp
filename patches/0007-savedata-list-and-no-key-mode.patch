+// The save lists. A PSP shows its list for LISTLOAD, LISTSAVE, LISTDELETE and
+// the delete mode without a save name (PPSSPP's LISTALLDELETE: every save of
+// the game, to free space with), and the player picks an entry: one per name
+// of the game's list (LISTSAVE: free slots too, as NEW DATA), or one per save
+// folder of the game.
+enum class ListKind { Load, Save, Delete };
+
+struct ListEntry {
+    std::string name;  // the save name, appended to the game name
+    bool exists{};
+    // PARAM.SFO's, the file a save writes last: when the save was made.
+    std::filesystem::file_time_type modified{};
+};
+
+std::optional<ListKind> list_kind(const psprecomp::GuestMemory &memory, std::uint32_t params) {
+    switch (memory.load32(params + param::kMode)) {
+    case kListLoad: return ListKind::Load;
+    case kListSave: return ListKind::Save;
+    case kListDelete: return ListKind::Delete;
+    case kDelete:
+        // Wipeout Pure's PROFILE > DELETE asks this with no save name.
+        if (save_name_at(memory, params + param::kSaveName).empty()) return ListKind::Delete;
+        return std::nullopt;
+    default: return std::nullopt;
+    }
+}
+
+savedata::SaveFiles folder_of(const psprecomp::GuestMemory &memory, std::uint32_t params, const std::string &name) {
+    savedata::SaveFiles files;
+    files.game_name = read_cstring(memory, params + param::kGameName, 13u);
+    files.save_name = name;
+    return files;
+}
+
+// Every entry of the request's list, in the game's order, saves and free
+// slots alike.
+std::vector<ListEntry> list_entries(const psprecomp::GuestMemory &memory, std::uint32_t params) {
+    std::vector<std::string> names;
+    if (const std::uint32_t list = memory.load32(params + param::kSaveNameList); list != 0u) {
+        names = save_name_list(memory, list);
+    } else if (memory.load32(params + param::kMode) == kDelete) {
+        const std::string game_name = read_cstring(memory, params + param::kGameName, 13u);
+        std::error_code error;
+        for (const auto &entry :
+             std::filesystem::directory_iterator(savedata::savedata_root(state().memory_stick), error)) {
+            const std::string folder = entry.path().filename().string();
+            if (entry.is_directory(error) && folder.size() > game_name.size() && folder.starts_with(game_name))
+                names.push_back(folder.substr(game_name.size()));
+        }
+        std::sort(names.begin(), names.end());
+    } else {
+        names.push_back(save_name_at(memory, params + param::kSaveName));
+    }
+    std::vector<ListEntry> entries;
+    for (const auto &name : names) {
+        ListEntry entry;
+        entry.name = name;
+        const auto files = folder_of(memory, params, name);
+        entry.exists = savedata::save_exists(state().memory_stick, files);
+        std::error_code error;
+        if (entry.exists)
+            entry.modified = std::filesystem::last_write_time(
+                savedata::save_folder(state().memory_stick, files) / "PARAM.SFO", error);
+        entries.push_back(std::move(entry));
+    }
+    return entries;
+}
+
+std::optional<std::size_t> newest_save(const std::vector<ListEntry> &entries) {
+    std::optional<std::size_t> newest;
+    for (std::size_t i = 0; i < entries.size(); ++i)
+        if (entries[i].exists && (!newest || entries[i].modified > entries[*newest].modified)) newest = i;
+    return newest;
+}
+
+std::optional<std::size_t> first_free(const std::vector<ListEntry> &entries) {
+    for (std::size_t i = 0; i < entries.size(); ++i)
+        if (!entries[i].exists) return i;
+    return std::nullopt;
+}
+
+// The entry a player would want without looking: the newest save to load,
+// the first free slot to save to, and only the save the game names to delete.
+std::optional<std::size_t> default_entry(const psprecomp::GuestMemory &memory, std::uint32_t params, ListKind kind,
+                                         const std::vector<ListEntry> &entries) {
+    switch (kind) {
+    case ListKind::Load: return newest_save(entries);
+    case ListKind::Save: return first_free(entries);
+    case ListKind::Delete: {
+        const std::string named = save_name_at(memory, params + param::kSaveName);
+        for (std::size_t i = 0; i < entries.size(); ++i)
+            if (entries[i].exists && !named.empty() && entries[i].name == named) return i;
+        return std::nullopt;
+    }
+    }
+    return std::nullopt;
+}
+
+const char *default_reason(ListKind kind) {
+    switch (kind) {
+    case ListKind::Load: return "the newest save";
+    case ListKind::Save: return "the first free slot";
+    case ListKind::Delete: return "the save the game names";
+    }
+    return "";
+}
+
+// The input script's `save` answer as an entry: `cancel` is nullopt; an answer
+// that names no usable entry (a free slot to load from, say) does not fit.
+struct ScriptAnswer {
+    bool fits{};
+    std::optional<std::size_t> entry;
+};
+
+ScriptAnswer resolve_answer(const std::string &answer, ListKind kind, const std::vector<ListEntry> &entries) {
+    if (answer == "cancel") return {true, std::nullopt};
+    std::optional<std::size_t> entry;
+    if (answer == "newest") {
+        entry = newest_save(entries);
+    } else if (answer == "free") {
+        if (kind == ListKind::Save) entry = first_free(entries);
+    } else {
+        for (std::size_t i = 0; i < entries.size() && !entry; ++i)
+            if (entries[i].name == answer) entry = i;
+        if (!entry && !answer.empty() && answer.find_first_not_of("0123456789") == std::string::npos) {
+            const unsigned long position = std::strtoul(answer.c_str(), nullptr, 10);
+            if (position < entries.size()) entry = position;
+        }
+    }
+    if (!entry || (kind != ListKind::Save && !entries[*entry].exists)) return {};
+    return {true, entry};
+}
+
+// Loads, saves or deletes the chosen entry, whose name the game reads back
+// from the block afterwards (its autosaves go to the profile's slot).
+std::uint32_t act_on(psprecomp::GuestMemory &memory, std::uint32_t params, ListKind kind, const std::string &name) {
+    write_cstring(memory, params + param::kSaveName, name, 20u);
+    switch (kind) {
+    case ListKind::Load: return do_load(memory, params, name);
+    case ListKind::Save: return do_save(memory, params, name);
+    case ListKind::Delete: return do_delete(memory, params, name);
+    }
+    return result::kLoadParam;
+}
+
+#if defined(PORTABLEKIT_HAS_RENDERER)
+std::vector<std::uint8_t> read_whole_file(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return {};
+    return std::vector<std::uint8_t>(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+}
+
+// "2026/10/07   14:03": a save's date and time as the PSP's list gives them.
+std::string save_date(std::filesystem::file_time_type written) {
+    // file_time_type's clock is not the system clock everywhere; offset by now.
+    const auto system_time = std::chrono::system_clock::now() +
+                             std::chrono::duration_cast<std::chrono::system_clock::duration>(
+                                 written - std::filesystem::file_time_type::clock::now());
+    const std::time_t time = std::chrono::system_clock::to_time_t(system_time);
+    std::tm tm{};
+#if defined(_WIN32)
+    localtime_s(&tm, &time);
+#else
+    localtime_r(&time, &tm);
+#endif
+    char text[32];
+    std::snprintf(text, sizeof text, "%04d/%02d/%02d   %02d:%02d", tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday,
+                  tm.tm_hour, tm.tm_min);
+    return text;
+}
+
+std::string outcome_message(ListKind kind, std::uint32_t outcome) {
+    if (outcome == result::kOk) {
+        switch (kind) {
+        case ListKind::Load: return "Load completed.";
+        case ListKind::Save: return "Save completed.";
+        case ListKind::Delete: return "Delete completed.";
+        }
+    }
+    switch (outcome) {
+    case result::kLoadNoData:
+    case result::kDeleteNoData: return "There is no save data.";
+    case result::kLoadDataBroken: return "The save data is corrupted.";
+    case result::kSaveAccessError:
+    case result::kSaveParam: return "The save data could not be written.";
+    default: return "The save data could not be loaded.";
+    }
+}
+
+// What the list shows of a save: PARAM.SFO's titles and detail, when it was
+// made, its size and ICON0.PNG.
+ui::SaveListEntry shown_save(const psprecomp::GuestMemory &memory, std::uint32_t params, const std::string &name) {
+    ui::SaveListEntry shown;
+    shown.name = name;
+    shown.exists = true;
+    const auto files = folder_of(memory, params, name);
+    const auto folder = savedata::save_folder(state().memory_stick, files);
+    if (const auto sfo = savedata::ParamSfo::parse(read_whole_file(folder / "PARAM.SFO"))) {
+        shown.title = sfo->string("TITLE").value_or("");
+        shown.savedata_title = sfo->string("SAVEDATA_TITLE").value_or("");
+        shown.detail = sfo->string("SAVEDATA_DETAIL").value_or("");
+    }
+    std::error_code error;
+    shown.date = save_date(std::filesystem::last_write_time(folder / "PARAM.SFO", error));
+    shown.size_kb = savedata::save_size(state().memory_stick, files) / 1024u;
+    shown.icon = read_whole_file(folder / "ICON0.PNG");
+    return shown;
+}
+
+// Opens the list screen for the request, on the entry the default would take
+// (so a straight confirm never writes over a save). False when there is no
+// interface to draw it in.
+bool open_list_screen(psprecomp::GuestMemory &memory, std::uint32_t params, ListKind kind,
+                      const std::vector<ListEntry> &entries) {
+    ui::SaveListRequest request;
+    request.kind = kind == ListKind::Load   ? ui::SaveListKind::Load
+                   : kind == ListKind::Save ? ui::SaveListKind::Save
+                                            : ui::SaveListKind::Delete;
+    request.enter_cross = memory.load32(params + param::kButtonSwap) == 1u;
+    // The game's own icon for a free slot, if it passes one.
+    std::vector<std::uint8_t> new_icon;
+    if (const std::uint32_t new_data = memory.load32(params + param::kNewData);
+        new_data != 0u && memory.contains(new_data, 16u))
+        new_icon = read_file_data(memory, new_data);
+    const std::optional<std::size_t> preferred = default_entry(memory, params, kind, entries);
+    std::vector<std::string> names;
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        const ListEntry &entry = entries[i];
+        // Only LISTSAVE lists free slots.
+        if (kind != ListKind::Save && !entry.exists) continue;
+        if (preferred && *preferred == i) request.focus = names.size();
+        ui::SaveListEntry shown;
+        if (entry.exists) {
+            shown = shown_save(memory, params, entry.name);
+        } else {
+            shown.name = entry.name;
+            shown.icon = new_icon;
+        }
+        names.push_back(entry.name);
+        request.entries.push_back(std::move(shown));
+    }
+    if (request.entries.empty()) return false;
+    request.act = [&memory, params, kind, names](std::size_t index) {
+        const std::uint32_t outcome = act_on(memory, params, kind, names.at(index));
+        state().acted = outcome;
+        ui::SaveListOutcome told{outcome == result::kOk, outcome_message(kind, outcome), std::nullopt};
+        // The save just written, as the dialog shows it beside "Save completed.".
+        if (kind == ListKind::Save && outcome == result::kOk) told.saved = shown_save(memory, params, names.at(index));
+        return told;
+    };
+    const bool opened = ui::open_game_save_list(std::move(request), [](std::optional<std::size_t> chosen) {
+        SavedataState &s = state();
+        if (!s.waiting) return;  // closed by a request that replaced it
+        s.answer = chosen ? s.acted : result::kCancelled;
+    });
+    if (!opened) return false;
+    SavedataState &s = state();
+    s.waiting = true;
+    s.params = params;
+    s.acted = result::kCancelled;
+    s.answer.reset();
+    std::cerr << "[savedata] " << mode_name(memory.load32(params + param::kMode)) << ": the save list is open ("
+              << names.size() << " entries)\n";
+    return true;
+}
+#endif

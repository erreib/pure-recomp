+// A list mode: the result, answered at once, or nullopt while the list screen
+// is open for the player to choose.
+std::optional<std::uint32_t> answer_list(psprecomp::GuestMemory &memory, std::uint32_t params, ListKind kind) {
+    const std::vector<ListEntry> entries = list_entries(memory, params);
+    const auto existing = static_cast<std::size_t>(
+        std::count_if(entries.begin(), entries.end(), [](const ListEntry &e) { return e.exists; }));
+    const char *mode = mode_name(memory.load32(params + param::kMode));
+    if (trace_savedata()) {
+        std::cerr << "[savedata] " << mode << " list:";
+        for (const auto &entry : entries) std::cerr << " " << entry.name << (entry.exists ? " (save)" : " (free)");
+        std::cerr << "\n";
+    }
+
+    if (const auto answer = host::script::take_save_answer()) {
+        const ScriptAnswer chosen = resolve_answer(*answer, kind, entries);
+        if (chosen.fits) {
+            std::cerr << "[savedata] " << mode << ": the script's answer \"" << *answer << "\": "
+                      << (chosen.entry ? entries[*chosen.entry].name : std::string("cancel")) << "\n";
+            if (!chosen.entry) return result::kCancelled;
+            return act_on(memory, params, kind, entries[*chosen.entry].name);
+        }

+    return value;
+}
+
+// The game's picture in the window (letterboxed to the PSP's shape) and the
+// size of one PSP pixel in it.
+struct Psp {
+    ImVec2 origin;
+    float scale{1.0f};
+    [[nodiscard]] ImVec2 at(float x, float y) const { return {origin.x + x * scale, origin.y + y * scale}; }
+    [[nodiscard]] float px(float value) const { return value * scale; }
+};
+
+Psp psp_area() {
+    const ImGuiIO &io = ImGui::GetIO();
+    const float aspect = kPspWidth / kPspHeight;
+    float width = io.DisplaySize.x;
+    float height = io.DisplaySize.y;
+    if (width / height > aspect) width = height * aspect;
+    else height = width / aspect;
+    return {{std::round((io.DisplaySize.x - width) * 0.5f), std::round((io.DisplaySize.y - height) * 0.5f)},
+            height / kPspHeight};
+}
+
+// Decoded save icons, kept for the run: a profile's ICON0.PNG is the same
+// picture save after save, so a handful covers a game.
+struct Icon {
+    ImTextureData *texture{};
+    int width{};
+    int height{};
+};
+
+const Icon *icon_for(const std::vector<std::uint8_t> &png) {
+    static std::map<std::size_t, Icon> cache;
+    if (png.empty()) return nullptr;
+    const std::size_t key =
+        std::hash<std::string_view>{}(std::string_view(reinterpret_cast<const char *>(png.data()), png.size()));
+    auto found = cache.find(key);
+    if (found == cache.end()) {
+        if (cache.size() >= 32u) return nullptr;
+        Icon icon;
+        int width = 0;
+        int height = 0;
+        int channels = 0;
+        stbi_uc *pixels =
+            stbi_load_from_memory(png.data(), static_cast<int>(png.size()), &width, &height, &channels, 4);
+        if (pixels != nullptr && width > 0 && height > 0) {
+            auto *texture = IM_NEW(ImTextureData)();
+            texture->Create(ImTextureFormat_RGBA32, width, height);
+            std::memcpy(texture->GetPixels(), pixels, static_cast<std::size_t>(width) * height * 4u);
+            texture->UseColors = true;
+            ImGui::RegisterUserTexture(texture);
+            icon = {texture, width, height};
+        }
+        if (pixels != nullptr) stbi_image_free(pixels);
+        found = cache.emplace(key, icon).first;
+    }
+    return found->second.texture != nullptr ? &found->second : nullptr;
+}
+
+// Text as the PSP's dialogs draw it: white with a soft shadow, `size` PSP
+// pixels high.
+void text(ImDrawList *draw, const Psp &psp, float size, ImVec2 at, ImU32 color, const std::string &value,
+          float wrap = 0.0f) {
+    ImFont *font = ImGui::GetFont();
+    const float pixels = psp.px(size);
+    const float shadow = std::max(1.0f, psp.px(0.6f));
+    draw->AddText(font, pixels, {at.x + shadow, at.y + shadow}, IM_COL32(0, 0, 0, 150), value.c_str(), nullptr,
+                  wrap);
+    draw->AddText(font, pixels, at, color, value.c_str(), nullptr, wrap);
+}
+
+ImVec2 text_size(const Psp &psp, float size, const std::string &value, float wrap = 0.0f) {
+    return ImGui::GetFont()->CalcTextSizeA(psp.px(size), FLT_MAX, wrap, value.c_str());
+}
+
+constexpr ImU32 kWhite = IM_COL32(255, 255, 255, 255);
+constexpr ImU32 kGrey = IM_COL32(192, 192, 192, 255);
+
+const char *banner_title(SaveListKind kind) {
+    switch (kind) {
+    case SaveListKind::Load: return "Load";
+    case SaveListKind::Save: return "Save";
+    case SaveListKind::Delete: return "Delete";
+    }
+    return "";
+}
+
+void draw_banner(ImDrawList *draw, const Psp &psp) {
+    draw->AddRectFilled(psp.at(0, 0), psp.at(kPspWidth, 23), IM_COL32(88, 99, 99, 101));
+    draw->AddNgonFilled(psp.at(16, 12), psp.px(6.0f), IM_COL32(255, 255, 255, 220), 6);
+    const std::string title = banner_title(screen().request.kind);
+    const float size = 13.0f;
+    text(draw, psp, size, psp.at(30, 12 - size * 0.5f), kWhite, title);
+}
+
+// One entry's icon box: the save's ICON0.PNG fitted to the box's height, a
+// grey box when there is none.
+void draw_icon(ImDrawList *draw, const Psp &psp, const SaveListEntry &entry, float x, float y, float w, float h,
+               bool selected) {
+    const Icon *icon = icon_for(entry.icon);
+    float pad = 0.0f;
+    if (icon != nullptr) {
+        const float scaled = std::floor(static_cast<float>(icon->width) * h / static_cast<float>(icon->height));
+        pad = std::floor((w - scaled) * 0.5f);
+        w = scaled;
+        // A free slot's icon (the game's "empty" picture) is drawn dimmed.
+        const ImU32 tint = entry.exists ? IM_COL32(255, 255, 255, 255) : IM_COL32(119, 119, 119, 255);
+        draw->AddImage(icon->texture->GetTexRef(), psp.at(x + pad, y), psp.at(x + pad + w, y + h), {0, 0}, {1, 1},
+                       tint);
+    } else {
+        draw->AddRectFilled(psp.at(x, y), psp.at(x + w, y + h), IM_COL32(102, 102, 102, 136));
+        const std::string label = entry.exists ? entry.name : "NEW DATA";
+        const float size = selected ? 12.0f : 9.0f;
+        const ImVec2 measured = text_size(psp, size, label);
+        text(draw, psp, size,
+             {psp.at(x, y).x + (psp.px(w) - measured.x) * 0.5f, psp.at(x, y).y + (psp.px(h) - measured.y) * 0.5f},
+             entry.exists ? kWhite : kGrey, label);
+    }
+    if (selected) {
+        const float b = std::max(1.0f, psp.px(1.2f));
+        const ImVec2 min = psp.at(x + pad, y);
+        const ImVec2 max = psp.at(x + pad + w, y + h);
+        draw->AddRect({min.x - b * 0.5f, min.y - b * 0.5f}, {max.x + b * 0.5f, max.y + b * 0.5f},
+                      IM_COL32(255, 255, 255, 208), 0.0f, 0, b);
+    }
+}
+
+// Where entry `index` sits in the column while `selected` is chosen.
+struct Slot {
+    float x, y, w, h;
+};
+
+Slot slot_of(std::size_t index, std::size_t selected) {
+    if (index == selected) return {27.0f, 97.0f, 144.0f, 80.0f};
+    const float distance = static_cast<float>(index < selected ? selected - index : index - selected);
+    const float y = index < selected ? 97.0f - 13.0f - 45.0f * distance : 97.0f + 48.0f + 45.0f * distance;
+    return {58.5f, y, 81.0f, 45.0f};
+}
+
+// The column of icons; a click chooses an entry, a click on the chosen one
+// picks it. Returns true when an entry was picked.
+bool draw_column(ImDrawList *draw, const Psp &psp) {
+    Screen &s = screen();
+    bool picked = false;
+    const auto &entries = s.request.entries;
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        const Slot slot = slot_of(i, s.selected);
+        if (slot.y > kPspHeight || slot.y + slot.h < 0.0f) continue;
+        draw_icon(draw, psp, entries[i], slot.x, slot.y, slot.w, slot.h, i == s.selected);
+        ImGui::SetCursorScreenPos(psp.at(slot.x, slot.y));
+        ImGui::PushID(static_cast<int>(i));
+        if (ImGui::InvisibleButton("##entry", {std::max(1.0f, psp.px(slot.w)), std::max(1.0f, psp.px(slot.h))})) {
+            if (i == s.selected) picked = true;
+            else s.selected = i;
+        }
+        ImGui::PopID();
+    }
+    return picked;
+}
+
+// Beside the column: the chosen save's title, date, time and size, its
+// savedata title and detail; NEW DATA for a free slot.
+void draw_details(ImDrawList *draw, const Psp &psp) {
+    const Screen &s = screen();
+    const SaveListEntry &entry = s.request.entries[s.selected];
+    if (!entry.exists) {
+        const float size = 14.0f;
+        text(draw, psp, size, psp.at(180, 136 - size * 0.5f), kWhite, "NEW DATA");
+        return;
+    }
+    draw->AddRectFilled(psp.at(180, 136), psp.at(kPspWidth, 137), kWhite);
+    const float title_size = 13.0f;
+    const ImVec2 title = text_size(psp, title_size, entry.title);
+    text(draw, psp, title_size, {psp.at(180, 0).x, psp.at(0, 135).y - title.y}, kGrey, entry.title);
+    text(draw, psp, 11.5f, psp.at(180, 139), kWhite,
+         entry.date + "  " + std::to_string(entry.size_kb) + " KB");
+    text(draw, psp, 12.5f, psp.at(175, 159), kWhite, entry.savedata_title);
+    draw->PushClipRect(psp.at(175, 181), psp.at(kPspWidth, 250), true);
+    text(draw, psp, 11.5f, psp.at(175, 181), kWhite, entry.detail, psp.px(kPspWidth - 175 - 6));
+    draw->PopClipRect();
+}
+
+// The confirmation and the outcome: the chosen save's icon large on the left,
+// its savedata title, date and size under it, and the message, framed by two
+// lines, in the middle of the right half.
+void draw_message(ImDrawList *draw, const Psp &psp, const std::string &message, bool yes_no) {
+    const Screen &s = screen();
+    const SaveListEntry &entry = s.request.entries[s.selected];
+    draw_icon(draw, psp, entry, 27, 97, 144, 80, false);
+    if (entry.exists)
+        text(draw, psp, 11.0f, psp.at(8, 200), kWhite,
+             entry.savedata_title + "\n" + entry.date + "\n" + std::to_string(entry.size_kb) + " KB");
+    const float size = 13.0f;
+    // Each line centred on x 334, as the PSP sets its messages.
+    std::vector<std::string> lines;
+    for (std::size_t start = 0;;) {
+        const std::size_t end = message.find('\n', start);
+        lines.push_back(message.substr(start, end == std::string::npos ? std::string::npos : end - start));
+        if (end == std::string::npos) break;
+        start = end + 1u;
+    }
+    const float line_height = text_size(psp, size, "Ag").y / psp.scale;
+    const float half = line_height * static_cast<float>(lines.size()) * 0.5f;
+    float top = 136.0f - half;
+    float bottom = 136.0f + half;
+    if (yes_no) {
+        top -= 10.0f;
+        bottom += 10.0f;
+    }
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+        const ImVec2 measured = text_size(psp, size, lines[i]);
+        const float y = top + line_height * static_cast<float>(i);
+        text(draw, psp, size, {psp.at(334, 0).x - measured.x * 0.5f, psp.at(0, y).y}, kWhite, lines[i]);
+    }
+    if (yes_no) {
+        const float y = bottom - 9.0f;
+        const float choice_x = s.yes ? 302.0f : 366.0f;
+        draw->AddRectFilled(psp.at(choice_x - 18, y - 2), psp.at(choice_x + 18, y + 14), IM_COL32(192, 192, 192, 64));
+        for (const auto &[label, x] : {std::pair<const char *, float>{"Yes", 302.0f}, {"No", 366.0f}}) {
+            const ImVec2 label_size = text_size(psp, size, label);
+            text(draw, psp, size, {psp.at(x, 0).x - label_size.x * 0.5f, psp.at(0, y).y}, kWhite, label);
+            ImGui::SetCursorScreenPos(psp.at(x - 18, y - 2));
+            ImGui::PushID(label);
+            if (ImGui::InvisibleButton("##answer", {psp.px(36), psp.px(16)})) screen().yes = x < 330.0f;
+            ImGui::PopID();
+        }
+    }
+    draw->AddRectFilled(psp.at(202, top - 14), psp.at(466, top - 13), kWhite);
+    draw->AddRectFilled(psp.at(202, bottom + 14), psp.at(466, bottom + 15), kWhite);
+}
+
+// A PSP button's symbol, `size` PSP pixels across: X or O.
+void draw_symbol(ImDrawList *draw, const Psp &psp, ImVec2 at, float size, bool cross) {
+    const float r = psp.px(size * 0.5f);
+    const ImVec2 c{at.x + r, at.y + r};
+    const float thickness = std::max(1.0f, psp.px(1.4f));
+    for (const auto &[offset, color] :
+         {std::pair<float, ImU32>{std::max(1.0f, psp.px(0.6f)), IM_COL32(0, 0, 0, 150)}, {0.0f, kWhite}}) {
+        if (cross) {
+            const float s = r * 0.75f;
+            draw->AddLine({c.x - s + offset, c.y - s + offset}, {c.x + s + offset, c.y + s + offset}, color, thickness);
+            draw->AddLine({c.x - s + offset, c.y + s + offset}, {c.x + s + offset, c.y - s + offset}, color, thickness);
+        } else {
+            draw->AddCircle({c.x + offset, c.y + offset}, r * 0.8f, color, 0, thickness);
+        }
+    }
+}
+
+// The buttons along the bottom, where the PSP puts them: Enter, then Back
+// (Back alone once the work is done). With the keyboard, its keys instead.
+void draw_buttons(ImDrawList *draw, const Psp &psp, bool with_enter) {
+    const bool cross_enter = screen().request.enter_cross;
+    const bool keyboard = Layer::get().input_device() == InputDevice::Keyboard;
+    const float size = 11.5f;
+    const auto button = [&](float x, bool enter) {
+        const ImVec2 at = psp.at(x, 250);
+        float label_x = x + 14.5f;
+        if (keyboard) {
+            const std::string key = enter ? "Enter" : "Esc";
+            const ImVec2 measured = text_size(psp, 10.0f, key);
+            const float pad = psp.px(2.5f);
+            draw->AddRect({at.x, at.y}, {at.x + measured.x + pad * 2.0f, at.y + psp.px(size)}, kGrey, psp.px(2.0f));
+            text(draw, psp, 10.0f, {at.x + pad, at.y + (psp.px(size) - measured.y) * 0.5f}, kWhite, key);
+            label_x = x + (measured.x + pad * 2.0f) / psp.scale + 4.0f;
+        } else {
+            draw_symbol(draw, psp, at, size, enter == cross_enter);
+        }
+        text(draw, psp, 12.0f, psp.at(label_x, 249.5f), kWhite, enter ? "Enter" : "Back");
+    };
+    // Enter first, Back after it, at the PSP's two places.
+    if (with_enter) button(183.5f, true);
+    button(with_enter ? 261.5f : 183.5f, false);
+}
+
+void finish(std::optional<std::size_t> acted) {
+    Screen &s = screen();
+    if (!s.open) return;
+    s.open = false;
+    Layer &layer = Layer::get();
+    layer.set_interactive(false);
+    layer.shell().set_game_input(true);
+    SaveListDone done = std::move(s.on_done);
+    s.on_done = nullptr;
+    s.request = SaveListRequest{};
+    if (done) done(acted);
+}
+
+void act() {
+    Screen &s = screen();
+    s.outcome = s.request.act ? s.request.act(s.selected) : SaveListOutcome{};
+    if (s.outcome.saved) s.request.entries[s.selected] = std::move(*s.outcome.saved);
+    s.acted = s.selected;
+    s.stage = Stage::Done;
+}
+
+// Picking the chosen entry: a save that exists to save over or to delete is
+// asked about first.
+void pick() {
+    Screen &s = screen();
+    const bool exists = s.request.entries[s.selected].exists;
+    if (s.request.kind == SaveListKind::Delete || (s.request.kind == SaveListKind::Save && exists)) {
+        s.yes = false;
+        s.stage = Stage::Confirm;
+        return;
+    }
+    act();
+}
+
+struct Presses {
+    bool up{}, down{}, left{}, right{}, confirm{}, back{};
+};
+
+Presses read_presses() {
+    Layer &layer = Layer::get();
+    Presses p;
+    const auto pressed = [](std::initializer_list<ImGuiKey> keys) {
+        for (const ImGuiKey key : keys)
+            if (ImGui::IsKeyPressed(key, true)) return true;
+        return false;
+    };
+    p.up = pressed({ImGuiKey_UpArrow});
+    p.down = pressed({ImGuiKey_DownArrow});
+    p.left = pressed({ImGuiKey_LeftArrow});
+    p.right = pressed({ImGuiKey_RightArrow});
+    p.confirm = ImGui::IsKeyPressed(ImGuiKey_Enter, false) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false);
+    p.back = layer.take_back();
+    // A button held when the list opened, such as the one that asked for it,
+    // does nothing until it is released.
+    if (!layer.gamepad_armed()) return p;
+    // The PSP's Enter and Back are its X and O, which the game reads from
+    // the buttons the pad mapping gives them (shell/gamepad.cpp): X is the
+    // south face button unless the "Confirm button" setting moves it east.
+    const bool south = layer.confirm_south();
+    const ImGuiKey cross = south ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+    const ImGuiKey circle = south ? ImGuiKey_GamepadFaceDown : ImGuiKey_GamepadFaceRight;
+    const bool enter_cross = screen().request.enter_cross;
+    const ImGuiKey confirm = enter_cross ? cross : circle;
+    const ImGuiKey back = enter_cross ? circle : cross;
+    p.up = p.up || pressed({ImGuiKey_GamepadDpadUp, ImGuiKey_GamepadLStickUp});
+    p.down = p.down || pressed({ImGuiKey_GamepadDpadDown, ImGuiKey_GamepadLStickDown});
+    p.left = p.left || pressed({ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadLStickLeft});
+    p.right = p.right || pressed({ImGuiKey_GamepadDpadRight, ImGuiKey_GamepadLStickRight});
+    p.confirm = p.confirm || ImGui::IsKeyPressed(confirm, false);
+    p.back = p.back || ImGui::IsKeyPressed(back, false) || ImGui::IsKeyPressed(ImGuiKey_GamepadFaceUp, false);
+    return p;
+}
+
+} // namespace
+
+bool open_game_save_list(SaveListRequest request, SaveListDone on_done) {
+    Layer &layer = Layer::get();
+    if (!layer.attached() || request.entries.empty()) return false;
+    if (screen().open) cancel_save_list();
+    Screen &s = screen();
+    s = Screen{};
+    s.open = true;
+    s.selected = std::min(request.focus, request.entries.size() - 1u);
+    s.request = std::move(request);
+    s.on_done = std::move(on_done);
+    // The game reads a neutral pad until it closes.
+    layer.shell().set_game_input(false);
+    layer.set_interactive(true);
+    std::cout << "[ui] save list open: " << banner_title(s.request.kind) << ", " << s.request.entries.size()
+              << " entries, on " << s.request.entries[s.selected].name << std::endl;
+    return true;
+}
+
+bool save_list_open() { return screen().open; }
+
+void cancel_save_list() { finish(std::nullopt); }
+
+void save_list_frame() {
+    Screen &s = screen();
+    if (!s.open) return;
+    Layer &layer = Layer::get();
+    // The menu does not open over the list.
+    (void)layer.take_menu_toggle();
+
+    const Presses presses = read_presses();
+    switch (s.stage) {
+    case Stage::List:
+        if (presses.back) {
+            std::cout << "[ui] save list: backed out" << std::endl;
+            finish(std::nullopt);
+            return;
+        }
+        if (presses.up && s.selected > 0u) --s.selected;
+        if (presses.down && s.selected + 1u < s.request.entries.size()) ++s.selected;
+        if (presses.confirm) pick();
+        break;
+    case Stage::Confirm:
+        if (presses.left) s.yes = true;
+        if (presses.right) s.yes = false;
+        if (presses.back || (presses.confirm && !s.yes)) s.stage = Stage::List;
+        else if (presses.confirm) act();
+        break;
+    case Stage::Done:
+        if (presses.back || presses.confirm) {
+            std::cout << "[ui] save list: " << s.outcome.message << std::endl;
+            finish(s.acted);
+            return;
+        }
+        break;
+    }
+
+    const ImGuiIO &io = ImGui::GetIO();
+    const Psp psp = psp_area();
+    ImGui::SetNextWindowPos({0, 0}, ImGuiCond_Always);
+    ImGui::SetNextWindowSize(io.DisplaySize, ImGuiCond_Always);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, {0, 0});
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0.0f);
+    ImGui::Begin("##savelist", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoScrollWithMouse | ImGuiWindowFlags_NoBackground);
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    // Over the game's own picture, as on a PSP (Wipeout Pure draws a plain
+    // grey screen with a blinking memory stick while the dialog is up). The
+    // banner goes on last, over the icons that scroll under it.
+    bool picked = false;
+    switch (s.stage) {
+    case Stage::List:
+        picked = draw_column(draw, psp);
+        draw_details(draw, psp);
+        break;
+    case Stage::Confirm:
+        draw_message(draw, psp,
+                     s.request.kind == SaveListKind::Delete
+                         ? "This save data will be deleted.\nAre you sure you want to continue?"
+                         : "Do you want to overwrite the data?",
+                     true);
+        break;
+    case Stage::Done:
+        draw_message(draw, psp, s.outcome.message, false);
+        break;
+    }
+    draw_banner(draw, psp);
+    draw_buttons(draw, psp, s.stage != Stage::Done);
+    ImGui::End();
+    ImGui::PopStyleVar(2);
+    if (picked && s.stage == Stage::List) pick();
+    else if (s.stage == Stage::Done && ImGui::IsMouseClicked(ImGuiMouseButton_Left)) finish(s.acted);
+}
+
+} // namespace portablekit::ui

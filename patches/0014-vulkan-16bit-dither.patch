+layout(constant_id = 11) const uint kDestinationFactor = 0u;
+layout(constant_id = 12) const uint kEquation = 0u;
+layout(constant_id = 13) const uint kFixSource = 0u;
+layout(constant_id = 14) const uint kFixDestination = 0u;
+layout(constant_id = 15) const float kPixelScaleX = 1.0;
+layout(constant_id = 16) const float kPixelScaleY = 1.0;

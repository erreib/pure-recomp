+        kept = uvec3((top.r << 3u) | (top.r >> 2u), (top.g << 2u) | (top.g >> 4u), (top.b << 3u) | (top.b >> 2u));
+    } else if (kSixteen == 2u) {
+        uvec3 top = c >> 3u;
+        kept = (top << 3u) | (top >> 2u);
+    } else {
+        kept = (c >> 4u) * 17u;
+    }
+    return vec3(kept) / 255.0;
+}
+
+// The colour the target receives: an 8888 target's as it is, a 16-bit
+// target's blended, dithered and cut to its bits; the alpha as stored().
+vec4 written(vec4 color) {

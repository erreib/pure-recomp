+// What a 16-bit target keeps of a colour: the colour in 8-bit steps, plus,
+// when the draw dithers, the matrix's offset for the PSP pixel (row y & 3,
+// column x & 3, a signed 4-bit value), clamped once to 0..255; then the top
+// bits of each channel the format has (5650: 5, 6 and 5; 5551: 5; 4444: 4),
+// as the 8-bit value they expand to by repeating their bits, which the RGBA8
+// target holds and the 16-bit store packs back exactly. ge.metal's
+// sixteen_bit.
+vec3 sixteen_bit(vec3 rgb) {
+    vec3 value = roundEven(rgb * 255.0);
+    if (kDither) {
+        uvec2 at = uvec2(floor(gl_FragCoord.xy / vec2(kPixelScaleX, kPixelScaleY))) & 3u;
+        uint row = ((at.y < 2u ? kDitherRows01 : kDitherRows23) >> (16u * (at.y & 1u))) & 0xFFFFu;
+        uint nibble = (row >> (4u * at.x)) & 15u;
+        value += float(int(nibble ^ 8u) - 8);

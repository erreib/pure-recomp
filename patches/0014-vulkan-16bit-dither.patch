+vec3 fix_color(uint c) {
+    return vec3(float(c & 0xFFu), float((c >> 8u) & 0xFFu), float((c >> 16u) & 0xFFu)) / 255.0;
+}
+
+// The GE's blend factors for the shader's own blend: the source side's 0 and
+// 1 are the destination colour and one minus it, the destination side's the
+// source colour and one minus it; then SA, 1-SA, DA, 1-DA, the doubled 2SA,
+// 1-2SA, 2DA, 1-2DA (not clamped) and 10 FIX. Others are ONE on the source
+// side and ZERO on the destination side. ge.metal's ge_factor.
+vec3 ge_factor(uint factor, bool source_side, vec4 s, vec4 d) {
+    if (factor == 0u) return source_side ? d.rgb : s.rgb;
+    if (factor == 1u) return 1.0 - (source_side ? d.rgb : s.rgb);
+    if (factor == 2u) return vec3(s.a);
+    if (factor == 3u) return vec3(1.0 - s.a);
+    if (factor == 4u) return vec3(d.a);
+    if (factor == 5u) return vec3(1.0 - d.a);
+    if (factor == 6u) return vec3(2.0 * s.a);
+    if (factor == 7u) return vec3(1.0 - 2.0 * s.a);
+    if (factor == 8u) return vec3(2.0 * d.a);
+    if (factor == 9u) return vec3(1.0 - 2.0 * d.a);
+    if (factor == 10u) return fix_color(source_side ? kFixSource : kFixDestination);
+    return vec3(source_side ? 1.0 : 0.0);
+}
+
+// The GE's blend, unclamped: ADD, SUBTRACT (source minus destination),
+// REVERSE SUBTRACT, MIN, MAX and ABSDIFF (the last three without factors);
+// 6 and 7 as ADD. ge.metal's ge_blend.
+vec3 ge_blend(vec4 s, vec4 d) {
+    if (kEquation == 3u) return min(s.rgb, d.rgb);
+    if (kEquation == 4u) return max(s.rgb, d.rgb);
+    if (kEquation == 5u) return abs(s.rgb - d.rgb);
+    vec3 a = s.rgb * ge_factor(kSourceFactor, true, s, d);
+    vec3 b = d.rgb * ge_factor(kDestinationFactor, false, s, d);
+    if (kEquation == 1u) return a - b;
+    if (kEquation == 2u) return b - a;
+    return a + b;

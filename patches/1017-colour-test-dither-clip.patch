+// The colour test: COLORTESTENABLE (0x27), COLORTEST (0xD8, the function in
+// bits 0..1: 0 NEVER, 1 ALWAYS, 2 EQUAL, 3 NOTEQUAL), COLORREF (0xD9) and
+// COLORTESTMASK (0xDA), both 0x00BBGGRR. A fragment whose 8-bit colour under
+// the mask compares false with the reference under the mask is dropped.
+struct ColorTestState {
+    bool enabled{};
+    std::uint32_t function{};
+    std::uint32_t reference{};
+    std::uint32_t mask{0x00FFFFFFu};
+};
+
+// Dithering: DITHERENABLE (0x20) and the 4x4 matrix DITH0 to DITH3 (0xE2 to
+// 0xE5). DITHn is the matrix's row for the pixels whose y & 3 is n: four
+// signed 4-bit offsets, the one for x & 3 in bits 4 x (x & 3) .. +3. The
+// offset is added to the colour's 8-bit channels before a 16-bit target keeps
+// their top bits.
+struct DitherState {
+    bool enabled{};
+    std::array<std::uint32_t, 4> rows{};  // DITH0..3 bits 0..15
+
+    [[nodiscard]] int offset(std::uint32_t x, std::uint32_t y) const noexcept {
+        const std::uint32_t nibble = (rows[y & 3u] >> (4u * (x & 3u))) & 0xFu;
+        return static_cast<int>(nibble ^ 8u) - 8;
+    }
+};
+

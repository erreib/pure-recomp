diff --git a/host/gpu/record_backend.cpp b/host/gpu/record_backend.cpp
index 25c0922..b864fe7 100644
--- a/host/gpu/record_backend.cpp
+++ b/host/gpu/record_backend.cpp
@@ -141,6 +141,21 @@ public:
             note_vram(memory);
             if (call.texture.enabled) {
                 record_memory(memory, call.texture.address, texture_bytes(call.texture));
+                // The mip levels after the first, when the minification filter
+                // samples them (bit 2): each from its own address, at its own
+                // size and row length, with level 0's format.
+                if ((call.texture.min_filter & 4u) != 0u) {
+                    const std::uint32_t levels = std::min<std::uint32_t>(call.texture.level_count, 8u);
+                    for (std::uint32_t n = 1u; n < levels; ++n) {
+                        const TextureLevel &level = call.texture.levels[n - 1u];
+                        TextureState texels = call.texture;
+                        texels.address = level.address;
+                        texels.buffer_width = level.buffer_width;
+                        texels.width = level.width;
+                        texels.height = level.height;
+                        record_memory(memory, level.address, texture_bytes(texels));
+                    }
+                }
                 if (indexed(call.texture.format))
                     record_memory(memory, call.texture.clut_address, 512u * (call.texture.clut_format == 3u ? 4u : 2u));
             }
diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 3017e75..523a8ba 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -6203,6 +6203,10 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
     const float wrap_flags = no_texture_clamp ? 0.0f
                                               : (call.texture.wrap_s != 0u ? 2.0f : 0.0f) +
                                                     (call.texture.wrap_t != 0u ? 4.0f : 0.0f);
+    // The alpha test only: the colour test (DrawCall::color_test) is not
+    // drawn by this renderer, nor dithering (DrawCall::dither: 16-bit targets
+    // are drawn at 8 bits a channel), nor CLIPENABLE's depth clamp
+    // (DrawCall::clip_enabled: every draw is clipped at both depth planes).
     push.texture_params = {call.texture.enabled ? 1.0f + wrap_flags : 0.0f, static_cast<float>(call.texture.function),
                            static_cast<float>(call.alpha_test.enabled ? call.alpha_test.reference : 0u),
                            static_cast<float>(call.alpha_test.enabled ? call.alpha_test.function : 1u)};

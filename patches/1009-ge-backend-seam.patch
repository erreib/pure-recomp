 }
 
+PresentedImage VulkanRenderer::display_image(std::uint32_t display_address) const {
+    PresentedImage image;
+    if (!impl_ || !impl_->ready) return image;
+    const Impl &impl = *impl_;
+    // As present() chooses its source.
+    auto displayed = impl.targets.find(display_address);
+    if (displayed == impl.targets.end()) displayed = impl.targets.find(impl.last_drawn_target);
+    if (displayed == impl.targets.end()) return image;
+    const auto handle = [](auto value) {
+        std::uint64_t bits = 0u;
+        static_assert(sizeof(value) <= sizeof(bits));
+        std::memcpy(&bits, &value, sizeof(value));
+        return bits;
+    };
+    image.api = ImageApi::Vulkan;
+    image.address = displayed->first;
+    image.width = impl.target_extent.width;
+    image.height = impl.target_extent.height;
+    image.image = handle(displayed->second.color);
+    image.view = handle(displayed->second.color_view);
+    return image;
+}

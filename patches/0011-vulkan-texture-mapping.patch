+vec3 unit_or_zero(vec3 v) {
+    float length_squared = dot(v, v);
+    return length_squared > 0.0 ? v * inversesqrt(length_squared) : vec3(0.0);
+}
+
+// The texture coordinates of the texture matrix (mode 1) and the environment
+// map (mode 2), by the GE's rules as PPSSPP's hardware notes give them (the
+// UV modes; lighting, "Shade mapping"). Neither takes the texture scale and
+// offset; uv_remap only places the texture in the image sampled.
+void map_texture() {
+    vec4 remap = object.uv_remap;
+    if (int(object.texture_map.x + 0.5) == 1) {
+        // The source with the matrix's translation added, times the matrix:
+        // s, t and q, interpolated and divided per pixel.
+        int which = int(object.texture_map.y + 0.5);
+        vec3 source;
+        if (which == 0) source = in_position.xyz;
+        else if (which == 1) source = vec3(in_texcoord, 0.0);
+        else if (which == 2) source = unit_or_zero(in_normal);
+        else source = in_normal;
+        vec3 stq = (object.texture_matrix * vec4(source, 1.0)).xyz;
+        frag_texcoord = vec2(stq.x * remap.x + stq.z * remap.z, stq.y * remap.y + stq.z * remap.w);
+        frag_q = stq.z;
+        return;
+    }
+    // The environment map: s and t are (N.L' + 1) / 2 for the two shade
+    // lights, in world space. N is the normal through the world matrix, the
+    // dot product divided by its length; L' the light's position for a
+    // directional light, else the direction from the vertex to it,
+    // normalized, and for a diffuse-and-specular light normalized again after
+    // the viewer's direction is added. Lighting, the lights' enables and
+    // colours, attenuation and the spot cone play no part.
+    vec3 normal = mat3(object.world) * in_normal;
+    if (object.viewer.w > 0.5) normal = -normal;
+    float length_squared = dot(normal, normal);
+    float inverse_length = length_squared > 0.0 ? inversesqrt(length_squared) : 0.0;
+    vec3 world_position = (object.world * vec4(in_position.xyz, 1.0)).xyz;
+    vec2 st;
+    for (int i = 0; i < 2; ++i) {
+        int light = int((i == 0 ? object.texture_map.z : object.texture_map.w) + 0.5);
+        vec3 to_light = lighting.light_position[light].xyz;
+        if (int(lighting.light_direction[light].w + 0.5) != 0) to_light -= world_position;
+        to_light = unit_or_zero(to_light);
+        if (int(lighting.light_attenuation[light].w + 0.5) == 1) to_light = unit_or_zero(to_light + object.viewer.xyz);
+        st[i] = (dot(normal, to_light) * inverse_length + 1.0) * 0.5;
+    }
+    frag_texcoord = st * remap.xy + remap.zw;
+}
 

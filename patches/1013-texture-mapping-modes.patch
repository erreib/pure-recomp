+// Where a transformed draw's texture coordinates come from (TEXMAPMODE 0xC0,
+// TEXSHADELS 0xC1). Mode 0 takes the vertex's UVs through the texture scale
+// and offset; mode 1 multiplies the source TEXPROJMAP names by the texture
+// matrix (DrawCall::texture_matrix), giving s, t and q; mode 2 (environment
+// or shade mapping) takes s and t from the normal and the two shade lights.
+struct TextureMapState {
+    std::uint32_t map_mode{};       // 0xC0 bits 0..1: 0 UVs, 1 texture matrix, 2 environment map
+    std::uint32_t proj_source{};    // 0xC0 bits 8..9 (TEXPROJMAP): 0 position, 1 UV, 2 normalized normal, 3 normal
+    std::uint32_t shade_light_u{};  // 0xC1 bits 0..1: the light s comes from
+    std::uint32_t shade_light_v{};  // 0xC1 bits 8..9: the light t comes from
+};
+
 // A draw call: decoded vertices plus the state they are drawn with.
 struct DrawCall {
     PrimitiveType primitive{};

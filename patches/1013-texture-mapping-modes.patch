     // the colour (0xE8) and the alpha, i.e. the stencil, apart (0xE9).
     std::uint32_t color_write_mask{};
     std::uint32_t alpha_write_mask{};
+    // The texture mapping mode. The Vulkan renderer draws every draw with its
+    // UVs (mode 0) whatever this says.
+    TextureMapState texture_map;
 };
 

diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 62e6b23..7e7db60 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -1464,6 +1464,33 @@ void Menu::system() {
     dump_row("[save rows]");
     save_rows();
 
+    // The game's content packs (GameProfile::content_packs_label,
+    // SaveFolder::content_pack): how many the memory stick holds, each by
+    // name, and the import that installs them. The saves rows above leave
+    // them out.
+    if (const char *label = portablekit::game().content_packs_label; label != nullptr) {
+        const std::vector<savedata::ContentPack> packs = savedata::content_packs(savedata::memory_stick());
+        const auto installed = std::count_if(packs.begin(), packs.end(),
+                                             [](const savedata::ContentPack &pack) { return pack.installed; });
+        section(label);
+        const std::string count = std::to_string(installed) + " of " + std::to_string(packs.size()) + " installed";
+        info_row(label, count);
+        dump_detail(count);
+        dump_row("[content pack rows]");
+        ImGui::PushID("##content packs");
+        for (const savedata::ContentPack &pack : packs)
+            ui::info_row(pack.description.c_str(), pack.installed ? "Installed" : "Not installed");
+        ImGui::PopID();
+        std::string lower = label;
+        for (char &c : lower) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        if (button_row(("Install " + lower + "…").c_str(),
+                       {savedata::memory_stick().empty(), {},
+                        "Copy " + lower + " into " + portablekit::game().project_name +
+                            ": choose one's folder, a folder that holds them or a memory stick's PSP/SAVEDATA. "
+                            "Each is checked first; one it replaces is kept, not deleted."}))
+            open_import();
+    }
+
     section("About");
     info_row(portablekit::game().project_name, std::string(kBuildVersion));
     if (*kBuildLabel != '\0') info_row("Build", kBuildLabel);

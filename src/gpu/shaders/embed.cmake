# Embeds a Metal source file in the program as a string (task 049), run by the build when the file changes:
#   cmake -DINPUT=<ge.metal> -DOUTPUT=<ge_metal.hpp> -DNAME=<kShaderSource> -P embed.cmake
# OUTPUT is a header holding `inline const char *const NAME` in namespace pure::metal, a raw string literal whose text
# is INPUT's, byte for byte. The Metal backend compiles that text when it starts (newLibraryWithSource), as it
# compiled the string metal_shaders.h held before, and neither the app nor a headless build reads a file for it.
if(NOT INPUT OR NOT OUTPUT OR NOT NAME)
    message(FATAL_ERROR "usage: cmake -DINPUT=<file.metal> -DOUTPUT=<header> -DNAME=<identifier> -P embed.cmake")
endif()
file(READ "${INPUT}" source)
if(source MATCHES "\\)metal\"")
    message(FATAL_ERROR "${INPUT} holds )metal\", which would end the raw string early")
endif()
get_filename_component(input_name "${INPUT}" NAME)
file(WRITE "${OUTPUT}"
    "// Generated by src/gpu/shaders/embed.cmake from ${input_name}: edit that file, not this one.\n"
    "#pragma once\n\nnamespace pure::metal {\n\ninline const char *const ${NAME} = R\"metal(${source})metal\";\n\n"
    "} // namespace pure::metal\n")
